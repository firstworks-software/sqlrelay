# rc.sqlrelay, rc.sqlrcachemanager, com.firstworks.sqlrelay.plist and
# com.firstworks.sqlrcachemanager.plist are generated by configure from
# the matching .in template (configure.in's AC_CONFIG_FILES at lines
# 1317-1318 and 1325-1326).  the .in templates are hand maintained and
# stay tracked (#9751)
/rc.sqlrelay
/rc.sqlrcachemanager
/com.firstworks.sqlrelay.plist
/com.firstworks.sqlrcachemanager.plist

# sqlrelay.service and sqlrcachemanager.service are generated by running
# make in this directory (init/Makefile's all: target at line 25 builds
# each from the matching .in template, and its clean: target at line 39
# removes them) rather than by configure.  the .in templates are hand
# maintained and stay tracked (#9751)
/sqlrelay.service
/sqlrcachemanager.service
