<b><font color="#0000FF">&lt;instances&gt;</font></b>
	<b><font color="#0000FF">&lt;instance</font></b> <font color="#009900">id</font><font color="#990000">=</font><font color="#FF0000">"example"</font> <font color="#009900">dbase</font><font color="#990000">=</font><font color="#FF0000">"oracle"</font><b><font color="#0000FF">&gt;</font></b>
		<b><font color="#0000FF">&lt;listeners&gt;</font></b>
			<b><font color="#0000FF">&lt;listener</font></b> <font color="#009900">protocol</font><font color="#990000">=</font><font color="#FF0000">"oracle"</font> <font color="#009900">port</font><font color="#990000">=</font><font color="#FF0000">"1521"</font> <font color="#009900">serverversion</font><font color="#990000">=</font><font color="#FF0000">"11.2"</font><b><font color="#0000FF">/&gt;</font></b>
		<b><font color="#0000FF">&lt;/listeners&gt;</font></b>
