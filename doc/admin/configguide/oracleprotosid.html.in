		<b><font color="#0000FF">&lt;/listeners&gt;</font></b>
		<b><font color="#0000FF">&lt;connections&gt;</font></b>
			<b><font color="#0000FF">&lt;connection</font></b> <font color="#009900">string</font><font color="#990000">=</font><font color="#FF0000">"user=scott;password=tiger;oracle_home=/u01/app/oracle/product/12.1.0;oracle_sid=ora1"</font><b><font color="#0000FF">/&gt;</font></b>
