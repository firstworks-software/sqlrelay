.PRECIOUS: $(INS)

.wt.html.in:
	wt -i $< -o $@

.html.in.html:
	$(SSI) $<

all: $(OBJS)
	$(CHMOD) 644 $(OBJS)

$(OBJS): $(FRAGMENTS)

clean:
	$(RM) $(OBJS) $(WTOBJS)
