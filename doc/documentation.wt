=== Native APIs ===

The native SQL Relay client APIs provide advanced features like substitution and bind variables, multi-row fetches, client-side result set caching, and suspended sessions, transactions, and result sets.

{{{#!td
 '''Guides''':[[br]]
 [programming/c++.html C++][[br]]
 [programming/c.html C][[br]]
 [programming/cs.html C#][[br]]
 [programming/perl.html Perl][[br]]
 [programming/php.html PHP][[br]]
 [programming/python.html Python][[br]]
 [programming/ruby.html Ruby][[br]]
 [programming/java.html Java][[br]]
 [programming/tcl.html TCL][[br]]
 [programming/erlang.html Erlang][[br]]
 [programming/nodejs.html node.js][[br]]
}}}
{{{#!td
 '''References''':[[br]]
 [api/c++/html/annotated.html C++][[br]]
 [api/c/html/group__sqlrclientwrapper.html C][[br]]
 [api/cs/html/annotated.html C#][[br]]
 [api/perl/perl.html Perl][[br]]
 [api/php/index.html PHP][[br]]
 [api/python/PySQLRClient.py.html Python][[br]]
 [api/ruby/doc/index.html Ruby][[br]]
 [api/java/index.html Java][[br]]
 [api/tcl/index.html TCL][[br]]
 [api/erlang/html/index.html Erlang][[br]]
 [api/nodejs/html/annotated.html node.js][[br]]
}}}
{{{#!td
<div class="code" style="font-size: 9px; margin-left: 220px;">
<font face="monospace">
<font color="#800080">#!/usr/bin/perl</font><br/>
<br/>
<font color="#a52a2a"><b>use&nbsp;</b></font>SQLRelay::Connection;<br/>
<font color="#a52a2a"><b>use&nbsp;</b></font>SQLRelay::Cursor;<br/>
<br/>
<font color="#008b8b">$sqlrcon</font>=SQLRelay::Connection-&gt;new(<font color="#ff00ff">&quot;</font><font color="#ff00ff">examplehost</font><font color="#ff00ff">&quot;</font>,<font color="#ff00ff">9000</font>,<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<font color="#ff00ff">&quot;</font><font color="#ff00ff">/tmp/example.socket</font><font color="#ff00ff">&quot;</font>,<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<font color="#ff00ff">&quot;</font><font color="#ff00ff">exampleuser</font><font color="#ff00ff">&quot;</font>,<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<font color="#ff00ff">&quot;</font><font color="#ff00ff">examplepassword</font><font color="#ff00ff">&quot;</font>,<font color="#ff00ff">0</font>,<font color="#ff00ff">1</font>);<br/>
<font color="#008b8b">$sqlrcur</font>=SQLRelay::Cursor-&gt;new(<font color="#008b8b">$sqlrcon</font>);<br/>
<br/>
<font color="#008b8b">$sqlrcur</font><font color="#008b8b">-&gt;sendQuery</font>(<font color="#ff00ff">&quot;</font><font color="#ff00ff">select * from exampletable</font><font color="#ff00ff">&quot;</font>);<br/>
<font color="#a52a2a"><b>for</b></font>&nbsp;(<font color="#008b8b">$row</font>=<font color="#ff00ff">0</font>;&nbsp;<font color="#008b8b">$row</font>&lt;<font color="#008b8b">$sqlrcur</font><font color="#008b8b">-&gt;rowCount</font>();&nbsp;<font color="#008b8b">$row</font>++) {<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<font color="#a52a2a"><b>for</b></font>&nbsp;(<font color="#008b8b">$col</font>=<font color="#ff00ff">0</font>;&nbsp;<font color="#008b8b">$col</font>&lt;<font color="#008b8b">$sqlrcur</font><font color="#008b8b">-&gt;colCount</font>();&nbsp;<font color="#008b8b">$col</font>++) {<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<font color="#a52a2a"><b>print</b></font>(<font color="#008b8b">$sqlrcur</font><font color="#008b8b">-&gt;getField</font>(<font color="#008b8b">$row</font>,<font color="#008b8b">$col</font>).<font color="#ff00ff">&quot;</font><font color="#ff00ff">,</font><font color="#ff00ff">&quot;</font>);<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;}<br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<font color="#a52a2a"><b>print</b></font>(<font color="#ff00ff">&quot;</font><font color="#6a5acd">\n</font><font color="#ff00ff">&quot;</font>);<br/>
}
</font>
</div>
}}}

