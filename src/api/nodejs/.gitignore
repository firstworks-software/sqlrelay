# binding.gyp and package.json are generated by this directory's Makefile
# from binding_in.gyp and package_in.json - note the _in naming, not the .in
# suffix the rest of the tree uses - and must not be tracked (#9678).
# temp1.gyp and temp2.gyp are the scratch files the binding.gyp rule writes
# on the way, and build/ is everything node-gyp puts there
/binding.gyp
/package.json
/temp1.gyp
/temp2.gyp
/build/
