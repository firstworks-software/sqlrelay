# output of autogen.sh, configure, and libtool at the top of the tree.  the
# root Makefile's distclean target removes this same set - see the $(RM)
# and $(RMTREE) lists in Makefile - so these are generated files and must
# never be tracked (#9751).  the hand maintained templates they are
# generated from (configure.in, config.h.in, config.mk.in, the .pc.in
# files) stay tracked.
#
# every pattern here has a leading slash and so matches only at the repo
# root.  src/, test/, bin/, init/ and msvc/ have their own .gitignore
# files for what those directories produce - do not duplicate them here

# configure run output
/config.mk
/config.h
/config.log
/config.status
/config.cache
/configure.lineno
/libtool
/libtool.gcc
/autom4te.cache/
/autom4te-*.cache/

# autoconf and autoheader rename the file they are replacing to name~
# before writing the new one, so an autogen.sh run leaves these behind.
# They are the tools' own backups, not editor artifacts.
/configure~
/config.h~
/config.h.in~

# backup left by manual editing of configure
/configure.bak.*

# pkg-config files, generated by configure
/sqlrelay-c.pc
/sqlrelay-c++.pc

# droppings from ad-hoc probes and manually run tools
/probe-ase.log
/sybinit.err
/trac.log
/System.Data.SqlClient.SqlMetaData.xml
