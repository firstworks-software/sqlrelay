#!/bin/sh

# capture a JDBC login against the local oracleprotocol11g and
# oracleprotocol12c sqlrelay instances (test/sqlrelay.conf.d/
# oracleprotocol.conf; the port is read from that generated conf file
# at run time - see getport() below, since test.sh -randomports gives
# each run different ports), through oraproxy, then decode each
# capture and check that oradecode's auth key/value pair
# decoder (see #9000) reports the verifier type and session key length
# that sendAuthenticationChallenge() in src/protocols/oracle.cpp
# actually put on the wire:
#
#   11g (verifiertype="11g"): AUTH_VFR_DATA flags 0x1b25,
#                              AUTH_SESSKEY 96 hex chars
#   12c (verifiertype="12c"): AUTH_VFR_DATA flags 0x4815,
#                              AUTH_SESSKEY 64 hex chars
#
# The oracleprotocol11g / oracleprotocol12c instances must
# already be running (./test.sh oracleprotocol starts them, or by
# hand, from the test/ directory:
#   sqlr-start -config sqlrelay.conf.d/oracleprotocol.conf \
#       -id oracleprotocol11g
#   sqlr-start -config sqlrelay.conf.d/oracleprotocol.conf \
#       -id oracleprotocol12c
#
# oraproxy can't listen on 1522/1523 itself - the sqlr-listeners already
# own those ports - so it listens on a spare port instead and forwards
# to the real one; oracle.java takes that spare port as an argument
# (defaulting to 1522 when none is given, for the existing
# jdbcoracletest/jdbcsqlrelaytest scripts).

status=0

# oracleprotocol11g's and oracleprotocol12c's listener ports vary from
# run to run when test.sh was run with -randomports, so resolve them
# at run time instead of hardcoding them: honor ORACLEPROTOCOLPORT2 /
# ORACLEPROTOCOLPORT3 if the environment already has them (test.sh's
# export_ports() sets these in its own child process), else read them
# straight out of the generated conf file, else fall back to the
# historical defaults.
getport() {
	_id=$1
	_envval=$2
	_default=$3

	if ( test -n "$_envval" )
	then
		echo $_envval
		return 0
	fi

	_conf=../../sqlrelay.conf.d/oracleprotocol.conf

	if ( test -f "$_conf" )
	then
		_port=`sed -n "/id=\"$_id\"/,/<\/instance>/{/port=\"/p;}" "$_conf" | sed -n 's/.*port="\([0-9]*\)".*/\1/p'`
		if ( test -n "$_port" )
		then
			echo $_port
			return 0
		fi
	fi

	echo $_default
	return 0
}

checkcapture() {
	_label=$1
	_listenport=$2
	_destport=$3
	_capfile=$4
	_expectedflags=$5
	_expectedsesskeylen=$6

	rm -f $_capfile

	./oraproxy $_listenport localhost $_destport $_capfile &
	_proxypid=$!

	sleep 1

	java -cp ojdbc8.jar:. oracle $_listenport

	kill $_proxypid 2>/dev/null
	wait

	_decoded=`./oradecode $_capfile`

	if ( echo "$_decoded" | grep -q "verifier type (AUTH_VFR_DATA flags): $_expectedflags" )
	then
		echo "PASS: $_label: AUTH_VFR_DATA flags $_expectedflags"
	else
		echo "FAIL: $_label: expected AUTH_VFR_DATA flags $_expectedflags not found in $_capfile"
		status=1
	fi

	if ( echo "$_decoded" | grep -q "AUTH_SESSKEY length: $_expectedsesskeylen hex chars" )
	then
		echo "PASS: $_label: AUTH_SESSKEY length $_expectedsesskeylen hex chars"
	else
		echo "FAIL: $_label: expected AUTH_SESSKEY length $_expectedsesskeylen not found in $_capfile"
		status=1
	fi
}

destport11g=`getport oracleprotocol11g "$ORACLEPROTOCOLPORT2" 1522`
destport12c=`getport oracleprotocol12c "$ORACLEPROTOCOLPORT3" 1523`

checkcapture 11g 25221 $destport11g oracle11gauth.cap 0x1b25 96
checkcapture 12c 25222 $destport12c oracle12cauth.cap 0x4815 64

exit $status
