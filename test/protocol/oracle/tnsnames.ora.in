# @DONOTEDIT@
#
# The sqlrelay* aliases below point at the oracleprotocol listeners in
# test/sqlrelay.conf.d/oracleprotocol.conf.in.  Those listeners don't have to
# be on 1521-1524 - two sessions running this suite at once can't both have
# them - so the ports here are substituted from the same
# ORACLEPROTOCOLPORT1 through ORACLEPROTOCOLPORT4 that generate that file's
# listener ports, and one set of values drives both ends.  See the defaults
# and the make rule in this directory's Makefile; unset means 1521-1524, as
# before.
#
# The ora1 aliases are the real oracle server behind sqlrelay, not a
# listener, so their port stays 1521.  The sqlrelay* aliases resolve to
# this suite's own local listeners, so their Host is localhost; ora1's Host
# stays the real oracle server they connect through.

ora1 =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = oracle)(PORT = 1521))
    (CONNECT_DATA = (SERVER = DEDICATED) (SERVICE_NAME = ora1))
  )

sqlrelay =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL= TCP)(Host= localhost)(Port= @ORACLEPROTOCOLPORT1@))
    (CONNECT_DATA = (SID = ora1))
  )

sqlrelay11g =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL= TCP)(Host= localhost)(Port= @ORACLEPROTOCOLPORT2@))
    (CONNECT_DATA = (SID = ora1))
  )

sqlrelay12c =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL= TCP)(Host= localhost)(Port= @ORACLEPROTOCOLPORT3@))
    (CONNECT_DATA = (SID = ora1))
  )

sqlrelayconnectstrings =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL= TCP)(Host= localhost)(Port= @ORACLEPROTOCOLPORT4@))
    (CONNECT_DATA = (SID = ora1))
  )

# the oracleprotocolfetchatonce instance (see
# test/sqlrelay.conf.d/oracleprotocol.conf.in) - fetchatonce=1 on its
# connection string forces a real second fetch call, driving
# sendFetch3Response()'s error path instead of sendQuery3Response()'s (#9601)

sqlrelayfetchatonce =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL= TCP)(Host= localhost)(Port= @ORACLEPROTOCOLPORT5@))
    (CONNECT_DATA = (SID = ora1))
  )

# the oracleprotocoloci7 instance (see
# test/sqlrelay.conf.d/oracleprotocol.conf.in) - its own backend, since an
# OCI7-capable client is too old to authenticate to the same modern backend
# the other instances above use (#9654)

sqlrelayoci7 =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL= TCP)(Host= localhost)(Port= @ORACLEPROTOCOLPORT7@))
    (CONNECT_DATA = (SID = ora1))
  )

# the same, naming a service that is not there, for the authentication
# section's attach failure case

ora1bad =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = oracle)(PORT = 1521))
    (CONNECT_DATA = (SERVER = DEDICATED) (SERVICE_NAME = nosuchservice))
  )

sqlrelaybad =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL= TCP)(Host= localhost)(Port= @ORACLEPROTOCOLPORT1@))
    (CONNECT_DATA = (SID = nosuchsid))
  )

sqlrelay11gbad =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL= TCP)(Host= localhost)(Port= @ORACLEPROTOCOLPORT2@))
    (CONNECT_DATA = (SID = nosuchsid))
  )

sqlrelay12cbad =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL= TCP)(Host= localhost)(Port= @ORACLEPROTOCOLPORT3@))
    (CONNECT_DATA = (SID = nosuchsid))
  )

sqlrelayconnectstringsbad =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL= TCP)(Host= localhost)(Port= @ORACLEPROTOCOLPORT4@))
    (CONNECT_DATA = (SID = nosuchsid))
  )

sqlrelayfetchatoncebad =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL= TCP)(Host= localhost)(Port= @ORACLEPROTOCOLPORT5@))
    (CONNECT_DATA = (SID = nosuchsid))
  )

sqlrelayoci7bad =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL= TCP)(Host= localhost)(Port= @ORACLEPROTOCOLPORT7@))
    (CONNECT_DATA = (SID = nosuchsid))
  )
