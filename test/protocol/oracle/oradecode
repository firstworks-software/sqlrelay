# Decoder for capture files written by ./oraproxy.  Walks the TNS packet
# stream in both directions, labels each packet by its TNS packet type and
# (for TTC_TTI_FUNCTION / TTC_PROTOCOL_NEGOTIATION) its TTC/TTI code, and
# reports how many of a packet's bytes it was able to account for, so a
# short or wrong decode is visible instead of silently swallowed.
#
# The packet type, TTC code and TTI code tables, the 8-byte TNS header
# layout (a 2/2/1/1/2 split before PROTOCOL_VERSION_12 is negotiated, a
# 4/1/1/2 split - "large header" - from the ACCEPT packet onward once it
# is), and the TTIPRO (protocol negotiation response) body layout are all
# taken from src/protocols/oracle.cpp in this repository - see the
# TNS_PACKET_TYPE/TTC_*/TTI_* defines and putTtiResponse() there.  See
# #9098 and #8978.
#
# Usage:
#   ./oradecode CAPTUREFILE

import struct
import sys

DIR_NAMES = {
	b"C": "client -> server",
	b"S": "server -> client",
}

PACKET_TYPES = {
	1: "CONNECT",
	2: "ACCEPT",
	3: "ACKNOWLEDGE",
	4: "REFUSE",
	5: "REDIRECT",
	6: "DATA",
	7: "NULL",
	9: "ABORT",
	11: "RESEND",
	12: "MARKER",
	13: "ATTENTION",
	14: "CONTROL_INFO",
}

