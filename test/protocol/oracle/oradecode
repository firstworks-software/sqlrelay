PROTOCOL_VERSION_12 = 0x013B

# oracle's out-of-band "break" byte, which oraproxy records inline in the
# capture rather than out-of-band
TNS_BREAK = 0x21

# largest packet length accepted from a large (32-bit) TNS header - oracle's
# documented maximum sdu is 2mb, and the real server enforces
# resppacketsize<=sdu (src/protocols/oracle.cpp), so this cap is as loose as
# a legitimate packet can be while still catching a misread break byte,
# whose length reads as roughly 0x21000000 (~554mb). a small header's length
# field self-bounds at 65535 and needs no cap.
MAX_LARGE_PACKET = 2 * 1024 * 1024


def read_chunks(path):
	# yields (direction, payload) for each chunk oraproxy wrote
	with open(path, "rb") as f:
		while True:
			header = f.read(5)
			if not header:
				return
			if len(header) < 5:
				sys.stderr.write(
					"oradecode: truncated chunk header "
					"at end of file, stopping\n")
				return
			direction = header[0:1]
			(length,) = struct.unpack(">I", header[1:5])
			payload = f.read(length)
			if len(payload) < length:
				sys.stderr.write(
					"oradecode: truncated chunk payload "
					"at end of file, stopping\n")
				return
			yield direction, payload


class Stream:
	# reassembles the byte stream for one direction out of possibly many
	# chunks, and tracks whether TNS packets on it use the small (pre
	# PROTOCOL_VERSION_12) or large (post) header
	def __init__(self, name):
		self.name = name
		self.buf = b""
		self.largeheader = False

	def feed(self, data):
		self.buf += data

	def take_packets(self):
		# yields complete TNS packets as they become available;
		# leaves a trailing partial packet in self.buf for the next
		# feed()
		while True:
			if len(self.buf) < 8:
				return

			# read the header
			pkttype = self.buf[4]
			flags = self.buf[5]
			if self.largeheader:
				(length,) = struct.unpack(">I", self.buf[0:4])
			else:
				(length,) = struct.unpack(">H", self.buf[0:2])

			# sanity-check it
			valid = (pkttype in PACKET_TYPES and
					length >= 8 and
					(not self.largeheader or
						length <= MAX_LARGE_PACKET))

			# a capture can carry the break byte inline, right where a
			# packet header is expected. only drop it when header
			# validation actually failed, though - a small header's
			# length can legitimately begin with 0x21 (0x21xx is a
			# plausible packet size), and dropping it unconditionally
			# would misframe valid traffic.
			if not valid:
				if self.buf[0] == TNS_BREAK:
					sys.stderr.write(
						"oradecode: skipping inline "
						"TNS break byte (0x21) and "
						"resyncing on %s\n" % self.name)
					self.buf = self.buf[1:]
					continue
				return

			# wait for the rest of the packet
			if len(self.buf) < length:
				return

			packet = self.buf[0:length]
			self.buf = self.buf[length:]
			yield pkttype, flags, packet[8:]


def hexdump(data, indent="    "):
	lines = []
	for off in range(0, len(data), 16):
		chunk = data[off:off + 16]
		hexpart = " ".join("%02x" % b for b in chunk)
		asciipart = "".join(
			chr(b) if 0x20 <= b < 0x7f else "." for b in chunk)
		lines.append("%s%04x  %-47s  %s" %
				(indent, off, hexpart, asciipart))
	return "\n".join(lines)


def read_cstring(data, offset):
	end = data.index(b"\x00", offset)
	return data[offset:end].decode("latin-1"), end + 1


def decode_ttipro_body(body):
	# putTtiResponse() in src/protocols/oracle.cpp - the server's
	# protocol-negotiation response (also documented byte-by-byte on
	# #8978, cross-checked against python-oracledb).
	out = []
	pos = 0

	version = body[pos]
	out.append("      %-28s %s" % ("version:", version))
	pos += 1

	out.append("      zero byte")
	pos += 1

	banner, newpos = read_cstring(body, pos)
	out.append("      %-28s %r" % ("server banner:", banner))
	pos = newpos

	charset, = struct.unpack_from("<H", body, pos)
	out.append("      %-28s %s" % ("charset:", charset))
	pos += 2

	serverflags = body[pos]
	out.append("      %-28s %s" % ("server flags:", serverflags))
	pos += 1

	graphcount, = struct.unpack_from("<H", body, pos)
	pos += 2
	out.append("      %-28s %d" % ("graph element count:", graphcount))
	graphbytes = graphcount * 5
	if graphbytes:
		out.append("      charset graph elements (%d bytes):" %
				graphbytes)
		out.append(hexdump(body[pos:pos + graphbytes], "        "))
	pos += graphbytes

	fdosize, = struct.unpack_from(">H", body, pos)
	pos += 2
	out.append("      %-28s %d" % ("fdo length:", fdosize))
	fdostart = pos
	fdodatasize, = struct.unpack_from(">I", body, pos)
	out.append("      %-28s %d" % ("fdo datasize:", fdodatasize))
	pos += 4
	pos += 1  # the constant 0x01 byte
	part1size = body[pos]
	pos += 1
	part2size = body[pos]
	pos += 1
	out.append("      %-28s %d" % ("fdo part1 size:", part1size))
	out.append("      %-28s %d" % ("fdo part2 size:", part2size))
	part1 = body[pos:pos + part1size]
	pos += part1size
	part2 = body[pos:pos + part2size]
	pos += part2size
	out.append("      fdo part1:")
	out.append(hexdump(part1, "        "))
	out.append("      fdo part2:")
	out.append(hexdump(part2, "        "))

	fdocharset, = struct.unpack_from(">H", body, pos)
	pos += 2
	fdoncharset, = struct.unpack_from(">H", body, pos)
	pos += 2
	out.append("      %-28s %d" % ("fdo charset:", fdocharset))
	out.append("      %-28s %d" % ("fdo national charset:", fdoncharset))
	pos += 1  # trailer byte (0x03 on real servers)

	fdoend = fdostart + fdosize
	padsize = fdoend - pos
	if padsize > 0:
		out.append("      %-28s %d bytes" %
				("fdo padding:", padsize))
	pos = fdoend

	if pos < len(body):
		compilecapssize = body[pos]
		pos += 1
		compilecaps = body[pos:pos + compilecapssize]
		pos += compilecapssize
		out.append("      %-28s %d" %
				("compile caps size:", compilecapssize))
		out.append(hexdump(compilecaps, "        "))

		runtimecapssize = body[pos]
		pos += 1
		runtimecaps = body[pos:pos + runtimecapssize]
		pos += runtimecapssize
		out.append("      %-28s %d" %
				("runtime caps size:", runtimecapssize))
		out.append(hexdump(runtimecaps, "        "))

	consumed = pos
	total = len(body)
	out.append("      -- consumed %d of %d TTIPRO body bytes --" %
			(consumed, total))
	return "\n".join(out), consumed, total


def read_ub4(data, offset):
	# putUb4()/getUb4() in src/protocols/oracle.cpp, portable encoding: a
	# length byte (0, 1, 2 or 4) followed by that many big-endian bytes,
	# with a zero length byte meaning the value 0 and nothing more.
	lensize = data[offset]
	offset += 1
	value = 0
	for i in range(lensize):
		value = (value << 8) | data[offset + i]
	return value, offset + lensize


def decode_auth_pairs(body):
	# the auth challenge's key/value pair stream: putAuthField() in
	# src/protocols/oracle.cpp writes a ub4 pair count, then per pair a
	# ub4 name length + length-prefixed name, a ub4 value length +
	# (if nonzero) a length-prefixed value, and a ub4 flags word. Real
	# 11g/12c servers use this same portable ub4 encoding here regardless
	# of what getAuthField()'s "native encoding" heuristic decided for
	# the request that provoked it - confirmed against
	# samples/oracle122-login-select.cap (AUTH_VFR_DATA flags 0x4815,
	# AUTH_SESSKEY 64 hex chars) and
	# samples/oracle112-login-expiredpwd.cap (flags 0x1b25, 96 hex
	# chars). Only that portable encoding is decoded here; a native
	# encoded response would use fixed-width counts instead (see
	# getAuthCount()) and isn't handled. This is the 11g/12c reply to
	# TTI_LOGON_PRESENT_USER_REQ_AUTH_SESSKEY (0x76); the older 9i/O3LOGON
	# reply to plain TTI_LOGON_PRESENT_USER (0x52) names nothing and is
	# decoded by decode_o3logon_challenge() instead.
	out = []
	pos = 0

	paircount, pos = read_ub4(body, pos)
	out.append("      %-28s %d" % ("pair count:", paircount))

	for i in range(paircount):
		namesize, pos = read_ub4(body, pos)
		namelen = body[pos]
		pos += 1
		name = body[pos:pos + namelen].decode("latin-1")
		pos += namelen

		valuesize, pos = read_ub4(body, pos)
		value = ""
		if valuesize:
			valuelen = body[pos]
			pos += 1
			value = body[pos:pos + valuelen].decode("latin-1")
			pos += valuelen

		flags, pos = read_ub4(body, pos)

		out.append("      [%d] %s = %r (flags 0x%08x)" %
				(i, name, value, flags))

		if name == "AUTH_VFR_DATA":
			out.append("          -> verifier type "
					"(AUTH_VFR_DATA flags): 0x%04x" %
					flags)
		elif name == "AUTH_SESSKEY":
			out.append("          -> AUTH_SESSKEY length: "
					"%d hex chars" % len(value))

	consumed = pos
	total = len(body)
	if consumed < total:
		out.append("      trailer/undecoded (%d bytes):" %
				(total - consumed))
		out.append(hexdump(body[consumed:total], "        "))
		consumed = total

	return "\n".join(out), consumed, total


# putOci7Summary()'s field list, oracle.cpp ~7104-7182: the object a real
# 10.2 server answers an O3LOGON login, and every later oci7 call, with, in
# the portable encoding. every numbered field is a length-prefixed int, read
# the way read_ub4() does; the few written with a single raw byte via
# write() are marked "byte" below and stay one byte regardless of encoding
# or value - that's how the sequence number field survives unchanged between
# the portable and native captures below.
O3LOGON_SUMMARY_FIELDS = (
	("end of call status", "lpi"),
	("rows processed", "lpi"),
	("reserved", "lpi"),
	("reserved", "lpi"),
	("reserved", "lpi"),
	("cursor id", "lpi"),
	("parse error offset", "lpi"),
	("command type", "byte"),
	("reserved", "byte"),
	("reserved", "byte"),
	("reserved", "byte"),
	("reserved", "byte"),
	("reserved", "byte"),
	("rowid ub4", "lpi"),
	("rowid ub2", "lpi"),
	("rowid byte", "byte"),
	("rowid ub4", "lpi"),
	("rowid ub2", "lpi"),
	("reserved", "lpi"),
	("reserved", "byte"),
	("sequence number", "byte"),
	("reserved", "lpi"),
	("success iterations", "lpi"),
	("reserved", "lpi"),
	("reserved", "lpi"),
	("reserved", "lpi"),
	("reserved", "lpi"),
)


def decode_o3logon_summary_portable(body, pos):
	# a nested ttc code (TTC_ERROR, 0x04 for a successful call) followed by
	# O3LOGON_SUMMARY_FIELDS in order. decoded field by field rather than
	# against fixed offsets, so it reads correctly whatever values a given
	# call carries - confirmed against packet [0012] (the login challenge,
	# sequence number 2) and [0014] (the login answer, sequence number 3)
	# of samples/oracle102-oci7-portable-login-select.cap.
	out = []
	start = pos

	ttccode = body[pos]
	out.append("      %-28s 0x%02x (%s)" %
			("summary ttc code:", ttccode,
				TTC_CODES.get(ttccode, "unknown")))
	pos += 1

	for label, kind in O3LOGON_SUMMARY_FIELDS:
		if kind == "byte":
			value = body[pos]
			pos += 1
		else:
			value, pos = read_ub4(body, pos)
		out.append("      %-28s %d" % (label + ":", value))

	out.append("      -- summary object: %d bytes --" % (pos - start))
	return "\n".join(out), pos


def decode_o3logon_summary_native(body, pos):
	# the native encoding of the same object. no client of this module
	# ever reaches it - recvAuthenticationRequest() never sets
	# nativeencoding on the 9i path (oracle.cpp ~6719-6734) - so
	# putOci7Summary() only ever writes the portable form above, and there
	# is no writer in the source to check field boundaries against beyond
	# the leading one. decoded here only as far as confirmed against
	# samples/oracle102-oci7-native-login-select.cap: a nested ttc code,
	# the end of call status as a fixed 4-byte little endian field (the
	# same value the portable object's leading field carries), and two
	# more fields at fixed offsets from the summary's start that hold live
	# server data rather than constants. everything else, including where
	# the field boundaries between them fall, is unidentified and left as
	# a plain hex dump.
	out = []
	start = pos

	ttccode = body[pos]
	out.append("      %-28s 0x%02x (%s)" %
			("summary ttc code:", ttccode,
				TTC_CODES.get(ttccode, "unknown")))
	pos += 1

	endofcallstatus, = struct.unpack_from("<I", body, pos)
	out.append("      %-28s %d" % ("end of call status:", endofcallstatus))
	pos += 4

	live1off = start + 54
	live2off = start + 62

	if pos < live1off:
		out.append("      reserved, unidentified (%d bytes):" %
				(live1off - pos))
		out.append(hexdump(body[pos:live1off], "        "))
	live1, = struct.unpack_from("<H", body, live1off)
	out.append("      %-28s 0x%04x (offset %d, meaning unknown)" %
			("live value:", live1, live1off - start))
	pos = live1off + 2

	if pos < live2off:
		out.append("      reserved, unidentified (%d bytes):" %
				(live2off - pos))
		out.append(hexdump(body[pos:live2off], "        "))
	live2, = struct.unpack_from("<I", body, live2off)
	out.append("      %-28s 0x%08x (offset %d, meaning unknown)" %
			("live value:", live2, live2off - start))
	pos = live2off + 4

	return "\n".join(out), pos


def decode_o3logon_challenge(body):
	# sendAuthenticationChallenge()'s o3logon branch, oracle.cpp ~6965-
	# 6980: the phase-1 O3LOGON (9i) login reply. names nothing - no pair
	# count, no AUTH_SESSKEY field name, no flags - just a session key
	# length, the session key itself, and a trailing summary object
	# (putOci7Summary()). the length slot's own shape says which encoding
	# follows: a length-prefixed int (01 20) in the portable encoding
	# putAuthCount() uses, a fixed width little endian ub2 (20 00) in the
	# native one. decoded against chunk [0012] of both
	# samples/oracle102-oci7-portable-login-select.cap and
	# samples/oracle102-oci7-native-login-select.cap.
	out = []
	pos = 0
	native = (body[0] != 0x01)

	if native:
		sesskeysize, = struct.unpack_from("<H", body, pos)
		pos += 2
		out.append("      %-28s %d (native, fixed width ub2)" %
				("session key size:", sesskeysize))
	else:
		sesskeysize, pos = read_ub4(body, pos)
		out.append("      %-28s %d (portable, length-prefixed int)" %
				("session key size:", sesskeysize))

	keylen = body[pos]
	pos += 1
	sesskey = body[pos:pos + keylen].decode("latin-1")
	pos += keylen
	out.append("      %-28s %r" % ("session key:", sesskey))

	if native:
		decoded, pos = decode_o3logon_summary_native(body, pos)
	else:
		decoded, pos = decode_o3logon_summary_portable(body, pos)
	out.append(decoded)

	consumed = pos
	total = len(body)
	if consumed < total:
		out.append("      trailer/undecoded (%d bytes):" %
				(total - consumed))
		out.append(hexdump(body[consumed:total], "        "))
		consumed = total

	return "\n".join(out), consumed, total


ANO_MARKER = b"\xde\xad\xbe\xef"


# the calls a pre-10g client (9i sqlplus, an oci7 program, 9i oci8) makes and
# the answers a 10.2 server gives them.  the walker below reads each one field
# by field and accounts for every byte: a walk that runs off the end of a
# message, or stops short of it, says so instead of passing a misread off as a
# decode.  the field layouts are the ones src/protocols/oracle.cpp writes and
# reads - see the function named beside each decoder - checked against real
# 10.2 server captures: samples/10538-*-realserver-* for sqlplus and the
# define flags, oracle102-oci7-*.cap for an oci7 program.
#
# the encoding is the session's.  against a 10.2 server or this module it is
# native when the two platform banners in the protocol negotiation match and
# portable when they don't, but a 12.2 server runs native with a 9i x86 client
# whose banner differs from its own - samples/10325-redhat9x86-oci7-native-*.
# so the first TTI_OPEN decides it where there is one: its open size is a
# count, and the zero every capture carries there is four bytes native and one
# portable.  a count is then a fixed width little endian integer (only x86
# native sessions are on file); in the portable encoding it is a length byte
# and that many big endian bytes, as read_ub4() reads it.  a pointer is the
# client's own, four raw bytes, in both.
#
# the shapes of the 10g style call (TTI_QUERY3) answers decoded here - the
# describe, the return parameters - are the ones a real 10.2 server sends a
# client below field version 4 (9i): see FIELD_VERSION_10_2

FIELD_VERSION_10_2 = 4

QUERY2_OPTIONS = (
	(0x01, "PARSE"),
	(0x08, "BIND"),
	(0x10, "DEFINE"),
	(0x20, "EXECUTE"),
	(0x40, "FETCH"),
	(0x8000, "NOPLSQL"),
)

# a define descriptor's flag byte: which of the indicator, return length and
# return code pointers the client's odefin() passed, and the placeholder bit.
# a real server sends a column's indicator after its value when the first bit
# is set, and its return code when the third is - see
# samples/10538-redhat9x86-oci7-defineflags-*-realserver-oracle102.oraproxy
DEFINE_INDICATOR = 0x01
DEFINE_RETURN_LENGTH = 0x02
DEFINE_RETURN_CODE = 0x04
DEFINE_SKIPPED = 0x80


class WalkError(Exception):
	pass


class Walker:
	# reads fields off one message, one at a time, logging each with the
	# bytes it came from, and complains about any byte it didn't read

	def __init__(self, data, native, indent="      "):
		self.data = data
		self.pos = 0
		self.native = native
		self.indent = indent
		self.lines = []

	def remaining(self):
		return len(self.data) - self.pos

	def take(self, n):
		if n < 0 or self.pos + n > len(self.data):
			raise WalkError("needed %d bytes at offset %d, only %d "
					"left" % (n, self.pos, self.remaining()))
		chunk = self.data[self.pos:self.pos + n]
		self.pos += n
		return chunk

	def log(self, label, value, raw):
		hexpart = " ".join("%02x" % b for b in raw)
		if len(hexpart) > 36:
			hexpart = hexpart[:33] + "..."
		self.lines.append("%s%-36s %-14s [%s]" %
				(self.indent, label + ":", value, hexpart))

	def note(self, text):
		self.lines.append(self.indent + text)

	def byte(self, label):
		raw = self.take(1)
		self.log(label, str(raw[0]), raw)
		return raw[0]

	def count(self, label, width=4):
		start = self.pos
		if self.native:
			raw = self.take(width)
			value = int.from_bytes(raw, "little")
		else:
			size = self.take(1)[0]
			# a set top bit in the length byte means a negative
			# count - 81 01 is a null's indicator, -1
			negative = (size & 0x80) != 0
			size &= 0x7f
			if size > 8:
				raise WalkError("length byte 0x%02x at offset %d "
						"is no count" % (size, start))
			value = int.from_bytes(self.take(size), "big")
			if negative:
				value = -value
		self.log(label, str(value), self.data[start:self.pos])
		return value

	def pointer(self, label):
		raw = self.take(4)
		self.log(label, "0x" + raw.hex(), raw)
		return raw

	def raw(self, label, n):
		raw = self.take(n)
		self.log(label, "%d bytes" % n, raw)
		return raw

	def clr(self, label):
		# a length byte and that many bytes, or 0xfe and length-prefixed
		# chunks up to a zero length
		start = self.pos
		size = self.take(1)[0]
		if size == 0xfe:
			value = b""
			while True:
				chunk = self.take(1)[0]
				if not chunk:
					break
				value += self.take(chunk)
		else:
			value = self.take(size)
		shown = value.decode("latin-1")
		if len(shown) > 40:
			shown = shown[:37] + "..."
		self.log(label, repr(shown), self.data[start:self.pos])
		return value

	def finish(self):
		left = self.remaining()
		if left:
			self.lines.append("%s** WARNING: walk stopped %d bytes "
					"short of the end **" %
					(self.indent, left))
			self.lines.append(hexdump(self.data[self.pos:],
							self.indent + "  "))
		self.lines.append("%s-- accounted for %d of %d bytes --" %
					(self.indent, self.pos, len(self.data)))
		return self.lines


def legacy_summary(w):
	# putOci7Summary() / putOci7SummaryNative(), after the 0x04 ttc code:
	# what a real 10.2 server answers every legacy call with, and the
	# summary that ends a 10g style call's answer at field version 1 and 2
	# too.  an error number brings a message behind it
	if w.native:
		w.count("end of call status")
		w.byte("unexplained, 1 in every capture")
		w.count("rows processed")
		# the module writes the error number four bytes wide and two
		# zero bytes behind it, but a real ORA-01405 on a null fetched
		# with no indicator reads 7d 05 01 00 7d 05 here - the same
		# three fields the portable summary has at this point, two
		# bytes each
		oranum = w.count("error number", 2)
		w.count("reserved", 2)
		w.count("array error number", 2)
		w.count("cursor id", 2)
		w.count("parse error offset", 2)
		w.byte("command type")
		w.raw("reserved", 26)
		w.byte("sequence number")
		w.raw("reserved", 2)
		w.count("success iterations")
		w.raw("marker 36 01, reserved", 8)
		w.raw("server address", 4)
		w.raw("reserved", 28)
	else:
		w.count("end of call status")
		w.count("rows processed")
		oranum = w.count("error number")
		w.count("reserved")
		w.count("array error number")
		w.count("cursor id")
		w.count("parse error offset")
		w.byte("command type")
		w.raw("reserved", 5)
		w.count("rowid ub4")
		w.count("rowid ub2")
		w.byte("rowid byte")
		w.count("rowid ub4")
		w.count("rowid ub2")
		w.count("reserved")
		w.byte("reserved")
		w.byte("sequence number")
		w.count("reserved")
		w.count("success iterations")
		for i in range(4):
			w.count("reserved")
	if oranum:
		w.clr("error message")


def options_names(options):
	names = [name for bit, name in QUERY2_OPTIONS if options & bit]
	return "|".join(names) if names else "none"


def legacy_descriptor(w, i, kind):
	# getQuery2Descriptor(): the wire datatype, the flag byte, precision and
	# scale, then eight counts - the buffer size first and the character
	# set sixth.  the native one leads with a byte the portable one doesn't
	# have, and its last two counts take six bytes between them, split
	# where no capture says
	w.note("%s %d:" % (kind, i + 1))
	if w.native:
		w.byte("  leading byte")
	dty = w.byte("  datatype")
	flag = w.byte("  flag")
	w.byte("  precision")
	w.byte("  scale")
	bufsize = w.count("  buffer size")
	if w.native:
		for j in range(4):
			w.count("  reserved")
		w.count("  character set", 2)
		w.raw("  reserved, split unconfirmed", 6)
	else:
		for j in range(4):
			w.count("  reserved")
		w.count("  character set")
		w.count("  reserved")
		w.count("  reserved")
	if kind == "define":
		parts = []
		if flag & DEFINE_INDICATOR:
			parts.append("indicator")
		if flag & DEFINE_RETURN_LENGTH:
			parts.append("return length")
		if flag & DEFINE_RETURN_CODE:
			parts.append("return code")
		if flag & DEFINE_SKIPPED:
			parts.append("skipped")
		w.note("  -> flag 0x%02x: %s" %
			(flag, ", ".join(parts) if parts else "no pointers"))
	return (dty, flag, bufsize)


def legacy_request(w, tti, session):
	# the requests open(), query(), query2(), fetch() and close() in
	# src/protocols/oracle.cpp read, after the ttc and tti codes
	w.byte("sequence number")
	if tti == 0x02:
		w.pointer("cursor id pointer")
		w.count("open size")
		session["pending"] = (0x02, None)
	elif tti == 0x03:
		cursor = w.count("cursor id")
		w.pointer("unexplained pointer")
		w.count("declared text size")
		w.clr("statement text")
		session["pending"] = (0x03, cursor)
	elif tti == 0x05:
		cursor = w.count("cursor id")
		w.count("rows to fetch")
		session["pending"] = (0x05, cursor)
	elif tti == 0x08:
		cursor = w.count("cursor id")
		session["pending"] = (0x08, cursor)
	elif tti == 0x47:
		options = w.count("options")
		w.note("-> " + options_names(options))
		cursor = w.count("cursor id")
		session["pending"] = (0x47, cursor, options)
		if not options & 0x18 or not w.remaining():
			return
		# getQuery2Descriptors()
		w.pointer("pointer")
		w.pointer("pointer")
		w.count("reserved")
		w.count("reserved")
		w.pointer("pointer")
		w.count("reserved")
		w.pointer("pointer")
		w.count("reserved")
		w.pointer("pointer")
		w.pointer("define array pointer")
		defines = w.count("define count")
		w.pointer("bind array pointer")
		binds = w.count("bind count")
		for i in range(7):
			w.count("row count" if i == 1 else "reserved")
		deflist = []
		for i in range(defines):
			deflist.append(legacy_descriptor(w, i, "define"))
		for i in range(binds):
			legacy_descriptor(w, i, "bind")
		if binds and w.remaining():
			w.byte("row data (0x07)")
			for i in range(binds):
				w.clr("bind %d value" % (i + 1))
		if options & 0x10:
			session["defines"][cursor] = deflist


def piggyback_request(w, session):
	# a ttc 0x11 message: a call that rides ahead of another, then the
	# other one, which is what the answer is for
	tti = w.byte("piggybacked tti code")
	w.byte("sequence number")
	if tti == 0x69:
		# close cursors: a pointer, a count and that many cursor ids
		w.pointer("cursor array pointer")
		n = w.count("cursor count")
		for i in range(n):
			w.count("cursor id")
	elif tti == 0x6b:
		w.count("session id")
		w.count("serial number")
		w.count("mode")
	else:
		raise WalkError("piggybacked tti 0x%02x not decoded" % tti)
	ttc = w.byte("embedded ttc code")
	inner = w.byte("embedded tti code")
	w.note("-> embedded %s" % TTI_CODES.get(inner, "unknown"))
	if ttc == 0x03 and inner in (0x02, 0x03, 0x05, 0x08, 0x47):
		legacy_request(w, inner, session)
		return
	session["pending"] = (inner, None)
	if w.remaining():
		w.raw("embedded request, not decoded", w.remaining())


def describe_info(w, session):
	# putDescribeInfo()/putDescribeInfoBody()/putColumnMetadata(), in the
	# shape a real 10.2 server sends a client below field version 4: no
	# column position behind each column's name, and nothing behind the
	# describe's date.  the precision and scale are raw bytes there
	fv = session.get("fieldversion")
	w.clr("query hash and date")
	w.count("max row size")
	columns = w.count("column count")
	if columns:
		w.byte("unexplained (0x39 from 10.2, 0x51 from 12.2)")
	sizes = []
	for i in range(columns):
		w.note("column %d:" % (i + 1))
		w.byte("  datatype")
		w.byte("  flags")
		w.byte("  precision")
		w.byte("  scale")
		sizes.append(w.count("  buffer size"))
		w.count("  max array elements")
		w.count("  continuation flags")
		w.count("  oid length")
		w.count("  version")
		w.count("  character set")
		w.byte("  character set form")
		w.count("  max size")
		w.byte("  nulls allowed")
		w.byte("  v7 name length")
		w.count("  name length")
		w.clr("  name")
		w.count("  schema length")
		w.count("  type name length")
		if fv is not None and fv >= FIELD_VERSION_10_2:
			w.count("  column position")
	w.count("date length")
	w.clr("date")
	if fv is not None and fv >= FIELD_VERSION_10_2:
		w.count("dcbflag")
		w.count("max data block size")
		w.count("min prefetch")
		w.count("max prefetch")
	session["describecolumns"] = columns
	session["describesizes"] = sizes


def return_parameters(w, session):
	# putReturnParameters(): the al8o4 vector, al8txl, the session state
	# key/value pairs.  a 10.2 server sends a client below field version 4
	# no registration id behind them
	fv = session.get("fieldversion")
	n = w.count("al8o4 count", 2)
	for i in range(n):
		w.count("al8o4[%d]" % i)
	txl = w.count("al8txl", 2)
	if txl:
		w.raw("al8txl", txl)
	pairs = w.count("key/value pair count", 2)
	for i in range(pairs):
		if w.count("key %d length" % (i + 1), 2):
			w.clr("key %d" % (i + 1))
		if w.count("value %d length" % (i + 1), 2):
			w.clr("value %d" % (i + 1))
		w.count("flags %d" % (i + 1), 2)
	if fv is not None and fv >= FIELD_VERSION_10_2:
		w.count("registration id")


def legacy_rows(w, session, cursor):
	# putRowHeader() or the native literal in sendFetchResponse(), then
	# the rows putRow() writes: per column the client defined, its value,
	# then its indicator and its return code where its define asked for
	# them
	if w.native:
		block = w.raw("native row header, field split unconfirmed", 29)
		w.note("-> column count %d, row count %d" %
			(block[3], int.from_bytes(block[4:8], "big")))
		columns = block[3]
	else:
		w.byte("flags")
		columns = w.count("column count", 2)
		w.count("iteration number")
		w.count("row count")
		w.count("buffer length", 2)
		if w.count("bit vector length"):
			raise WalkError("bit vector not decoded")
		if w.count("rxhrid length"):
			raise WalkError("rxhrid not decoded")
	deflist = session["defines"].get(cursor)
	if deflist:
		wanted = [d for d in deflist
				if not (d[1] & DEFINE_SKIPPED and not d[2])]
	else:
		w.note("no define list on file for cursor %s - assuming "
			"%d columns with an indicator and a return code each" %
			(cursor, columns))
		wanted = [(0, DEFINE_INDICATOR | DEFINE_RETURN_CODE, 0)] * \
								columns
	row = 0
	while w.remaining() and w.data[w.pos] == 0x07:
		row += 1
		w.byte("row %d marker" % row)
		for i, (dty, flag, bufsize) in enumerate(wanted):
			w.clr("  column %d value" % (i + 1))
			if flag & DEFINE_INDICATOR:
				w.count("  column %d indicator" % (i + 1), 2)
			if flag & DEFINE_RETURN_CODE:
				w.count("  column %d return code" % (i + 1), 2)


def oall8_rows(w, session):
	# a 10g style call's row header and rows: the row header's fields, then
	# per row its marker and one value per described column
	w.byte("flags")
	w.count("column count", 2)
	w.count("iteration number")
	w.count("row count")
	w.count("buffer length", 2)
	if w.count("bit vector length"):
		raise WalkError("bit vector not decoded")
	if w.count("rxhrid length"):
		raise WalkError("rxhrid not decoded")


def decode_legacy_answer(body, ttccode, session):
	# the answer to the call session["pending"] names, from its first ttc
	# code on.  one answer can carry several messages back to back, each
	# behind its own ttc code
	native = session.get("native")
	w = Walker(body, native)
	pending = session.get("pending") or (None, None)
	tti, cursor = pending[0], pending[1]
	code = ttccode
	first = True
	while True:
		if not first:
			if not w.remaining():
				break
			code = w.byte("ttc code")
		w.note("-> %s" % TTC_CODES.get(code, "0x%02x" % code))
		first = False
		if code == 0x04:
			legacy_summary(w)
			break
		elif code == 0x09:
			w.count("end of call status")
			break
		elif code == 0x08 and tti == 0x02:
			w.count("cursor id")
		elif code == 0x08 and tti == 0x68:
			w.count("transaction state")
		elif code == 0x08 and tti == 0x47:
			# sendQuery2Response()
			w.count("lead-in, 2 whatever the cursor", 2)
			if native:
				w.raw("server address", 4)
			else:
				size = w.byte("server address length")
				w.raw("server address", size)
			w.count("reserved")
		elif code == 0x08:
			return_parameters(w, session)
		elif code == 0x06 and tti in (0x05, 0x47):
			legacy_rows(w, session, cursor)
		elif code == 0x06:
			oall8_rows(w, session)
		elif code == 0x07 and session.get("describecolumns"):
			# a real 10.2 server follows each value with an
			# indicator and a return code for a client whose
			# CCAP_TTC1 lacks 0x08 (python-oracledb's
			# TNS_CCAP_IND_RCD) - 9.0.1, which sends 0x07 - and
			# with nothing for one that sets it - 9.2.0.4, which
			# sends 0x7f.  a column described 0 bytes wide, null
			# by describe, has no value at all, only those two
			ttc1 = session.get("clientttc1")
			indicators = ttc1 is not None and not (ttc1 & 0x08)
			sizes = session.get("describesizes") or []
			for i in range(session["describecolumns"]):
				if i >= len(sizes) or sizes[i]:
					w.clr("column %d value" % (i + 1))
				if indicators:
					w.count("column %d indicator" % (i + 1),
									2)
					w.count("column %d return code" %
								(i + 1), 2)
		elif code == 0x10 and native:
			raise WalkError("a native describe isn't decoded - "
					"no capture pins its field widths")
		elif code == 0x10:
			describe_info(w, session)
		else:
			raise WalkError("no message this walker reads starts "
					"with ttc code 0x%02x (offset %d)" %
					(code, w.pos - 1))
	return w.finish()


def note_negotiation(body, is_server_to_client, session):
	# what the encoding and field version decisions need: both platform
	# banners and both field versions
	try:
		if body[2] == 0x01 and not is_server_to_client:
			start = body.index(b"\x00", 3) + 1
			banner, pos = read_cstring(body, start)
			session["clientbanner"] = banner
		elif body[2] == 0x01:
			banner, pos = read_cstring(body, 5)
			session["serverbanner"] = banner
		elif body[2] == 0x02 and not is_server_to_client:
			capsize = body[8]
			caps = body[9:9 + capsize]
			if len(caps) > 7:
				session["clientfieldversion"] = caps[7]
			if len(caps) > 15:
				session["clientttc1"] = caps[15]
	except (ValueError, IndexError):
		return
	if ("clientbanner" in session and "serverbanner" in session and
						"openencoding" not in session):
		session["native"] = (session["clientbanner"] ==
						session["serverbanner"])
	if "clientfieldversion" in session:
		session["fieldversion"] = session["clientfieldversion"]


def old_client(session):
	# a client whose field version says it is older than 10g.  a newer
	# client making the same legacy calls - instant client's oci7 support
	# - gets answers shaped for its own field version, which this doesn't
	# read
	fv = session.get("fieldversion")
	return fv is not None and fv < FIELD_VERSION_10_2


def decode_legacy(body, is_server_to_client, session):
	# returns decoded lines, or None when this isn't a message the walker
	# reads
	ttccode = body[2]
	rest = body[3:]
	if (not is_server_to_client and ttccode == 0x03 and rest and
				rest[0] == 0x02 and "openencoding" not in session and
				len(rest) in (7, 10)):
		session["openencoding"] = True
		session["native"] = (len(rest) == 10)
	native = session.get("native")
	if native is None:
		return None
	if not old_client(session):
		return None
	if not is_server_to_client:
		if ttccode == 0x03 and rest and rest[0] in (0x02, 0x03, 0x05,
								0x08, 0x47):
			w = Walker(rest[1:], native)
			legacy_request(w, rest[0], session)
			return w.finish()
		if ttccode == 0x03 and rest:
			session["pending"] = (rest[0], None)
		if ttccode == 0x11 and rest:
			w = Walker(rest, native)
			piggyback_request(w, session)
			return w.finish()
		return None
	if ttccode not in (0x04, 0x06, 0x08, 0x09, 0x10):
		return None
	# a summary reads the same whatever it answers.  the rest depend on
	# the call
	if ttccode != 0x04 and session.get("pending", (None,))[0] not in (
				0x02, 0x03, 0x05, 0x08, 0x47, 0x5e, 0x68):
		return None
	return decode_legacy_answer(rest, ttccode, session)


def decode_data_payload(body, is_server_to_client, authstate):
	if len(body) < 3:
		return ["    (data payload too short to have data flags "
			"+ ttc code)"]

	if len(body) >= 6 and body[2:6] == ANO_MARKER:
		# ANO (advanced networking option) negotiation: not
		# TTC-coded, it carries its own 0xdeadbeef-marked framing
		# (oracle.cpp anoNegotiation()/recvAnoRequest(), ~line 2187-
		# 2286).  Not decoded field by field here - just labeled and
		# dumped.
		dataflags, = struct.unpack_from(">H", body, 0)
		lines = ["    data flags: 0x%04x" % dataflags,
			"    ANO negotiation frame (undecoded, marked by "
			"0xdeadbeef)",
			"    payload (%d bytes):" % len(body),
			hexdump(body)]
		return lines

	note_negotiation(body, is_server_to_client, authstate)

	dataflags, = struct.unpack_from(">H", body, 0)
	ttccode = body[2]
	ttcname = TTC_CODES.get(ttccode, "unknown")
	lines = []
	lines.append("    data flags: 0x%04x" % dataflags)
	lines.append("    ttc code:   0x%02x (%s)" % (ttccode, ttcname))

	rest = body[3:]
	if ttccode in (0x03, 0x11) and rest:
		# TTC_TTI_FUNCTION / TTC_EXTENDED_TTI_FUNCTION: next byte is
		# the TTI function code
		tticode = rest[0]
		ttiname = TTI_CODES.get(tticode, "unknown")
		lines.append("    tti code:   0x%02x (%s)" %
				(tticode, ttiname))
		if not is_server_to_client and tticode in (
				0x76, 0x52):
			# TTI_LOGON_PRESENT_USER_REQ_AUTH_SESSKEY /
			# TTI_LOGON_PRESENT_USER: the client's phase-1 logon
			# request. The server's answer (a TTC_OK carrying
			# either an AUTH_SESSKEY/AUTH_VFR_DATA pair stream or,
			# for a plain 0x52 9i/O3LOGON request, a positional
			# session key + summary object) follows as the next
			# server -> client DATA packet. Remember which TTI
			# code asked, since that's what picks the reply's
			# shape.
			authstate["awaiting_challenge"] = tticode
	elif (ttccode == 0x08 and is_server_to_client and
			authstate.get("awaiting_challenge")):
		# TTC_OK answering the phase-1 logon request.
		pending_tti = authstate["awaiting_challenge"]
		authstate["awaiting_challenge"] = False
		if pending_tti == 0x52:
			# the 9i/O3LOGON phase-1 reply: positional, no pair
			# count, no field names - see
			# decode_o3logon_challenge().
			try:
				decoded, consumed, total = \
						decode_o3logon_challenge(rest)
			except (struct.error, IndexError,
					UnicodeDecodeError) as e:
				lines.append(
					"    ** O3LOGON challenge decode "
					"failed (%s); falling back to hex "
					"dump **" % e)
			else:
				lines.append("    O3LOGON challenge "
						"(phase 1):")
				lines.append(decoded)
				return lines
		else:
			# the 11g/12c reply: AUTH_SESSKEY, AUTH_VFR_DATA, and
			# - for a 12c/pbkdf2 verifier - the AUTH_PBKDF2_*
			# fields, per sendAuthenticationChallenge() /
			# putAuthField() in src/protocols/oracle.cpp.
			try:
				decoded, consumed, total = \
						decode_auth_pairs(rest)
			except (struct.error, IndexError,
					UnicodeDecodeError) as e:
				lines.append(
					"    ** auth pair decode failed "
					"(%s); falling back to hex dump **" %
					e)
			else:
				lines.append("    auth challenge:")
				lines.append(decoded)
				return lines
	elif ttccode == 0x01 and rest and is_server_to_client:
		# TTC_PROTOCOL_NEGOTIATION, server -> client: a TTIPRO
		# response body, laid out the way putTtiResponse() writes
		# it.  The client -> server direction carries a request in
		# a different, much simpler layout (version, client flag
		# list, banner) that this does not attempt to decode.
		try:
			decoded, consumed, total = \
					decode_ttipro_body(rest)
		except (struct.error, IndexError, ValueError) as e:
			lines.append("    ** TTIPRO decode failed (%s); "
					"falling back to hex dump **" % e)
		else:
			lines.append("    TTIPRO response:")
			lines.append(decoded)
			if consumed != total:
				lines.append(
					"    ** WARNING: %d bytes left "
					"over after decode **" %
					(total - consumed))
			return lines

	# a pre-10g client's calls and their answers - see Walker
	try:
		decoded = decode_legacy(body, is_server_to_client, authstate)
	except WalkError as e:
		lines.append("    ** legacy call decode failed (%s); falling "
				"back to hex dump **" % e)
		decoded = None
	if decoded is not None:
		lines.append("    %s (%s encoding):" %
				("answer" if is_server_to_client else "request",
				"native" if authstate.get("native") else
								"portable"))
		lines.extend(decoded)
		return lines

	if rest:
		lines.append("    payload (%d bytes):" % len(rest))
		lines.append(hexdump(rest))
	return lines


def main():
	if len(sys.argv) != 2:
		sys.stderr.write("usage: %s CAPTUREFILE\n" % sys.argv[0])
		return 1

	streams = {
		b"C": Stream("client -> server"),
		b"S": Stream("server -> client"),
	}

	seqno = 0
	authstate = {"awaiting_challenge": False, "defines": {}}
	for direction, payload in read_chunks(sys.argv[1]):
		stream = streams.get(direction)
		if stream is None:
			sys.stderr.write(
				"oradecode: unknown direction byte %r, "
				"skipping chunk\n" % direction)
			continue
		stream.feed(payload)
		for pkttype, flags, body in stream.take_packets():
			seqno += 1
			typename = PACKET_TYPES.get(pkttype, "unknown")
			print("[%04d] %-18s PACKET_%s (type=%d, flags=0x%02x, "
				"%d body bytes)" %
				(seqno, stream.name, typename, pkttype,
					flags, len(body)))

			if pkttype == 1:  # CONNECT: read the negotiated
						# version to know when to
						# switch header formats
				if len(body) >= 2:
					version, = struct.unpack_from(
							">H", body, 0)
					print("    connect version: 0x%04x" %
						version)

			if pkttype == 2:  # ACCEPT: server has now committed
						# to a header size for the
						# rest of the connection
				if len(body) >= 2:
					acceptversion, = struct.unpack_from(
							">H", body, 0)
					print("    accept version: 0x%04x" %
						acceptversion)
					if acceptversion >= PROTOCOL_VERSION_12:
						for s in streams.values():
							s.largeheader = True
						print("    -> switching to "
							"large (32-bit "
							"length) TNS header "
							"from here on")

			if pkttype == 6:  # DATA
				for line in decode_data_payload(
						body, direction == b"S",
						authstate):
					print(line)

	# a non-empty buffer here is a trailing partial TNS packet that
	# never completed - report it instead of silently dropping it, the
	# same way a short TTC/TTIPRO decode is reported above rather than
	# swallowed
	for stream in streams.values():
		if stream.buf:
			sys.stderr.write(
				"oradecode: %d undecoded trailing bytes on "
				"%s\n" % (len(stream.buf), stream.name))

	return 0


if __name__ == "__main__":
	sys.exit(main())
