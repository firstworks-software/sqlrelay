#!/bin/sh

# capture a JDBC login+query against a local sqlr-listener speaking the
# oracle protocol, through oraproxy (jnettrace.jar is dead, see #9098),
# then decode it

rm -f sqlrelay.cap

./oraproxy 1522 localhost 1521 sqlrelay.cap &
proxypid=$!

sleep 1

java -cp ojdbc8.jar:. oracle

# oraproxy exits on its own once the one connection it handles closes;
# this kill only matters if java failed before ever connecting, so wait
# does not hang forever
kill $proxypid 2>/dev/null

wait

./oradecode sqlrelay.cap
