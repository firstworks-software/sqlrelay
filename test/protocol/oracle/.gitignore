/oracle
/ociselect
/oracledescribeonly
*.o
*.obj
*.lo
*.class
/.libs/

# scratch files the tnsnames.ora rule writes.  tnsnames.ora itself stays
# checked in so the default ports work without running make first, even
# though a plain make now regenerates it too (test/protocol/oracle is in
# TESTPROTOCOLSUBDIRS whenever an oracle client is configured)
*.out1
*.out2

# captures and traces written by running the tests.  the intentional,
# checked-in captures live under samples/ and are not ignored.
/*.cap
cli_*.trc
sqlnet.log
