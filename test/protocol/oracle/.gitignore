# tnsnames.ora is generated from tnsnames.ora.in by this directory's
# Makefile and must not be tracked (#9676).  its content is the
# oracleprotocol listener ports the checkout was built for, so a tracked
# copy is just one machine's ports.  a plain make writes it (it is in
# this directory's all: target, and test/protocol/oracle is in
# TESTPROTOCOLSUBDIRS whenever an oracle client is configured), and
# test.sh -randomports rewrites it again
/tnsnames.ora

# scratch files the tnsnames.ora rule writes
*.out1
*.out2

# captures and traces written by running the tests.  the intentional,
# checked-in captures live under samples/ and are not ignored.
/*.cap
cli_*.trc
sqlnet.log
