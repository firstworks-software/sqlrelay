#!/bin/sh

# capture a JDBC login+query against the real oracle122 test server,
# through oraproxy (jnettrace.jar is dead, see #9098), then decode it.
#
# oracle122 is the server with a working testuser login; oracle112's
# testuser password is expired (ORA-28001) as of this writing - see the
# README.

rm -f oracle122.cap

./oraproxy 1522 oracle122centos7x64.firstworks.com 1521 oracle122.cap &
proxypid=$!

sleep 1

java -cp ojdbc8.jar:. oracle

# oraproxy exits on its own once the one connection it handles closes;
# this kill only matters if java failed before ever connecting, so wait
# does not hang forever
kill $proxypid 2>/dev/null

wait

./oradecode oracle122.cap
