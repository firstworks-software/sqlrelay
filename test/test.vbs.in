' script-level state shared across the procedures below
dim PREFIX, CONFDIR, COMPUTERNAME, fso, WshShell
dim testinstances, testapis, failures, manage, up, instance
dim PING, BYPASS, TEST, TESTFILE

' print the usage message
sub usage()
	WScript.Echo("usage: cscript /nologo test.vbs [-n] [instances [apis]]")
	WScript.Echo("       cscript /nologo test.vbs -h")
	WScript.Echo("")
	WScript.Echo("  For each instance, start it, run the client API tests against it,")
	WScript.Echo("  then stop it.")
	WScript.Echo("")
	WScript.Echo("    instances  space-separated list of instances to test")
	WScript.Echo("               (default: every instance built)")
	WScript.Echo("    apis       space-separated list of client APIs to test")
	WScript.Echo("               (default: every API built)")
	WScript.Echo("")
	WScript.Echo("    -n         do not manage instances; assume each is already running")
	WScript.Echo("               and just run the tests against it")
	WScript.Echo("    -h         show this help and exit")
	WScript.Echo("")
	WScript.Echo("  Runs against different backend servers can go on at the same time,")
	WScript.Echo("  on one host.  But concurrency is per backend server, not per test.")
	WScript.Echo("  Every instance connects to a database named after the host, so tests")
	WScript.Echo("  that share a backend share a schema and the same testtable, and still")
	WScript.Echo("  have to run one at a time relative to each other:")
	WScript.Echo("")
	WScript.Echo("    mysql, mysqlupsert, mysqldeadlockreplay, mysqlsplitmultiinsert,")
	WScript.Echo("    mysqlimportexport and mysqlprotocol all hit the mysql server")
	WScript.Echo("    the postgresql family likewise")
	WScript.Echo("    oracle, tls, krb, extensions, crud and oracleprotocol all hit oracle")
end sub

' start or stop a sqlrelay daemon so its spawned listener/connection outlive
' this script.  Exec would kill them via its job object when the WshScriptExec
' is released; Run does not, and needs the exe path quoted (it has a space).
' #8484
sub daemon(prog, args)
	WshShell.Run Chr(34) & PREFIX & "\bin\" & prog & Chr(34) & " " & args, 0, false
end sub

' whether a pid file belongs to instance id.  sqlr-stop -id matches
' sqlr-listener-<id>.pid and sqlr-scaler-<id>.pid by full name, and
' sqlr-connection-<id>. by prefix (src/server/sqlr-stop.cpp:88-129)
function pidfilematches(name, id)
	dim connprefix
	connprefix="sqlr-connection-" & id & "."
	pidfilematches=(name="sqlr-listener-" & id & ".pid") or _
			(name="sqlr-scaler-" & id & ".pid") or _
			(Left(name,Len(connprefix))=connprefix)
end function

' instance id's pid files, as a tab-separated list of full paths.  collected
' in one pass, because deleting from the Files collection while iterating it
' is not safe.
function pidfiles(id)

	dim piddir, f, list

	pidfiles=""

	piddir=PREFIX & "\var\run\sqlrelay\"
	if not fso.FolderExists(piddir) then
		exit function
	end if

	list=""
	for each f in fso.GetFolder(piddir).Files
		if pidfilematches(f.Name,id) then
			list=list & f.Path & vbTab
		end if
	next
	pidfiles=list
end function

' make sure instance id is fully gone and no stale pid file of its own
' remains before starting it again - sqlr-stop is asynchronous and was
' sometimes too slow, leaving the next instance unable to come up ("failed to
' start").  #8484
'
' every instance has its own port and socket now, so runs against different
' backends can go on at the same time, and this must not tear another run's
' instances down.  that rules out taskkill /IM and a blanket delete of the pid
' directory, which would take every sqlr-listener.exe and every pid file on
' the host.  kill what this instance's own pid files name instead.
sub cleanslate(id)

	dim files, path, ts, pid

	files=Split(pidfiles(id),vbTab)

	' kill whatever each pid file names.  the tests are nested rather than
	' anded, because VBScript's and evaluates both sides.
	for each path in files
		if path<>"" then
			if fso.FileExists(path) then
				pid=""
				set ts=fso.OpenTextFile(path,1)
				if not ts.AtEndOfStream then
					pid=Trim(ts.ReadLine())
				end if
				ts.Close
				if IsNumeric(pid) then
					WshShell.Run "taskkill /F /PID " & pid, 0, true
				end if
			end if
		end if
	next
	WScript.Sleep 500

	' then remove the files themselves
	for each path in files
		if path<>"" then
			if fso.FileExists(path) then
				fso.DeleteFile path, true
			end if
		end if
	next
end sub

' stop any instances left running from a previous run.  only the instances
' this run is about - another run against a different backend may be going on
' at the same time, and must not be torn down.
sub stopinstances()

	dim instance

	for each instance in testinstances

		' skip instances that have no config file of their own
		if fso.FileExists(CONFDIR & "\" & instance & ".conf") then

			' the router test also has master/slave instances
			if instance="router" then
				daemon "sqlr-stop", "-config " & CONFDIR & "\" & instance & ".conf -id routermaster"
				daemon "sqlr-stop", "-config " & CONFDIR & "\" & instance & ".conf -id routerslave"
			end if

			daemon "sqlr-stop", "-config " & CONFDIR & "\" & instance & ".conf -id " & instance
		end if
	next
	WScript.Sleep(2000)
end sub

' whether this instance can be tested here; Windows builds only the modules
' that were configured, and the instance list already reflects that, so nothing
' is skipped (the shell version skips instances whose module was not built)
function instanceapplicable(instance)
	instanceapplicable=True
end function

' start the instance(s)
sub startinstance(instance)

	' make sure these instances are fully gone first
	if instance="router" then
		cleanslate "routermaster"
		cleanslate "routerslave"
	end if
	cleanslate instance

	' for the router test, start the master/slave instances
	if instance="router" then
		daemon "sqlr-start", "-config " & CONFDIR & "\" & instance & ".conf -id routermaster"
		WScript.Sleep(2000)

		daemon "sqlr-start", "-config " & CONFDIR & "\" & instance & ".conf -id routerslave"
		WScript.Sleep(2000)
	end if

	' start the instance
	daemon "sqlr-start", "-config " & CONFDIR & "\" & instance & ".conf -id " & instance
	WScript.Sleep(2000)
end sub

' stop the instance(s)
sub stopinstance(instance)

	if instance="router" then
		WScript.Sleep(2000)
		daemon "sqlr-stop", "-config " & CONFDIR & "\" & instance & ".conf -id routermaster"
		WScript.Sleep(2000)
		daemon "sqlr-stop", "-config " & CONFDIR & "\" & instance & ".conf -id routerslave"
	end if
	WScript.Sleep(2000)
	daemon "sqlr-stop", "-config " & CONFDIR & "\" & instance & ".conf -id " & instance
	WScript.Sleep(2000)
end sub

' collapse runs of whitespace to single spaces and trim
function collapsews(s)
	dim re
	set re=new RegExp
	re.Pattern="\s+"
	re.Global=True
	collapsews=Trim(re.Replace(s," "))
end function

' run a command and return its combined output as one collapsed line
function execoutput(cmd)
	dim c, s
	set c=WshShell.Exec(cmd)
	s=""
	do until c.StdOut.AtEndOfStream
		s=s & c.StdOut.ReadLine() & " "
	loop
	do until c.StdErr.AtEndOfStream
		s=s & c.StdErr.ReadLine() & " "
	loop
	execoutput=collapsews(s)
end function

' whether something is listening on a tcp port.  netstat writes the local
' address as 0.0.0.0:3306 or [::]:3306, so require the port to follow the
' address's : and to be followed by whitespace.  a bare number matches the
' foreign address and the other columns too.
function portlistening(port)
	dim c, line, re
	portlistening=False
	set re=new RegExp
	re.Pattern="[.:]" & port & "\s"
	set c=WshShell.Exec("netstat -an")
	do until c.StdOut.AtEndOfStream
		line=c.StdOut.ReadLine()
		if instr(line,"LISTENING")>0 and re.Test(line) then
			portlistening=True
		end if
	loop
end function

' wait for an instance to answer; sets BYPASS and returns True if up
function pinginstance(instance)

	dim i
	PING=""
	BYPASS="no"
	for i=1 to 15
		WScript.Echo("")
		WScript.Echo("pinging " & instance & "...")
		if instance="tls" then

			' -config/-id would pick the port up on its own, but
			' it would also pick up the config's default user, and
			' authCommand() in src/protocols/sqlrclient.cpp only
			' authenticates by client certificate when the user is
			' empty, so pass the port instead
			PING=execoutput(PREFIX & "\bin\sqlrsh -host localhost -port 9012 -tls -tlscert " & CONFDIR & "\tls\client.pem -tlsca " & CONFDIR & "\tls\ca.pem -tlsvalidate ca -command ping")
		elseif instance="mysqlprotocol" then
			if portlistening("3306") then
				PING="The database is up."
			else
				PING="0: Couldn't connect to the listener."
			end if
		elseif instance="postgresqlprotocol" then
			if portlistening("5432") then
				PING="The database is up."
			else
				PING="0: Couldn't connect to the listener."
			end if
		elseif instance="tdsfreetdsmssqlprotocol" then
			if portlistening("1433") then
				PING="The database is up."
			else
				PING="0: Couldn't connect to the listener."
			end if
		elseif instance="tdsfreetdssapprotocol" then
			if portlistening("9030") then
				PING="The database is up."
			else
				PING="0: Couldn't connect to the listener."
			end if
		elseif instance="tdssapprotocol" then
			if portlistening("9031") then
				PING="The database is up."
			else
				PING="0: Couldn't connect to the listener."
			end if
		elseif instance="oracleprotocol" then
			if portlistening("1521") then
				PING="The database is up."
			else
				PING="0: Couldn't connect to the listener."
			end if
		elseif instance="teradataprotocol" then
			if portlistening("1025") then
				PING="The database is up."
			else
				PING="0: Couldn't connect to the listener."
			end if
		else

			' extensions comes through here too - -config/-id
			' picks up its port, socket, user and password from
			' extensions.conf
			PING=execoutput(PREFIX & "\bin\sqlrsh -config " & CONFDIR & "\" & instance & ".conf -id " & instance & " -command ping")
		end if

		WScript.Echo(PING)

		if PING="0: Couldn't connect to the listener." then
			WScript.Sleep(5000)
		else

			' If ssl is sufficiently old then the ssl test will
			' fail like this.  Just bypass the test in that case.
			if instr(PING,"unknown message digest algorithm")>0 then
				BYPASS="yes"
			end if
			exit for
		end if
	next

	pinginstance=(PING="The database is up.")
end function

' set TEST and TESTFILE for running the instance's test under api
sub apicommand(instance, api)

	TEST=""
	TESTFILE=""
	select case api
		case "c"
			TEST=instance & ".exe"
			TESTFILE=instance & ".exe"
		case "c++"
			TEST=instance & ".exe"
			TESTFILE=instance & ".exe"
		case "extensions"
			TEST=instance & ".exe"
			TESTFILE=instance & ".exe"
		case "cs"
			TEST=instance & ".exe"
			TESTFILE=instance & ".exe"
		case "ado.net"
			TEST=instance & ".exe"
			TESTFILE=instance & ".exe"
		case "java"
			TEST="run.bat " & instance
			TESTFILE=instance & ".class"
		case "jdbc"
			TEST="run.bat " & instance
			TESTFILE=instance & ".class"
		case "nodejs"
			' the node on win7x64 is old (v4) and needs a flag to
			' parse the tests' object-destructuring require; harmless
			' on newer node, and this runner is windows-only
			TEST="node --harmony_destructuring " & instance & ".js"
			TESTFILE=instance & ".js"
		case "odbc"
			TEST=instance & ".exe"
			TESTFILE=instance & ".exe"
		case "perl"
			TEST="perl " & instance & ".pl"
			TESTFILE=instance & ".pl"
		case "perldbi"
			TEST="perl " & instance & ".pl"
			TESTFILE=instance & ".pl"
		case "php"
			TEST="php " & instance & ".php"
			TESTFILE=instance & ".php"
		case "phppdo"
			TEST="php " & instance & ".php"
			TESTFILE=instance & ".php"
		case "python"
			TEST="python -u " & instance & ".py"
			TESTFILE=instance & ".py"
		case "pythondb"
			TEST="python -u " & instance & ".py"
			TESTFILE=instance & ".py"
		case "ruby"
			TEST="ruby " & instance & ".rb"
			TESTFILE=instance & ".rb"
		case "tcl"
			TEST="tclsh " & instance & ".tcl"
			TESTFILE=instance & ".tcl"
		case "erlang"
			TEST="run.bat " & instance
			TESTFILE=instance & ".beam"
	end select
end sub

' run the instance's test under one api; returns 1 if the test ran and failed
function runapitest(instance, api)

	dim cmd
	runapitest=0

	WScript.Echo("testing " & instance & " in " & api)
	WScript.Echo("")
	WshShell.CurrentDirectory=api

	' figure out how to run this api's test
	apicommand instance, api

	' run it
	if fso.FileExists(TESTFILE) then
		set cmd=WshShell.Exec(TEST)
		do until cmd.StdOut.AtEndOfStream
			WScript.Echo(cmd.StdOut.ReadLine())
		loop
		if cmd.ExitCode<>0 then
			WScript.Echo("")
			WScript.Echo("")
			WScript.Echo(instance & " failed in " & api)
			runapitest=1
		else
			WScript.Echo("")
			WScript.Echo("test complete")
		end if
	else
		WScript.Echo("no test found for " & instance & " in " & api)
	end if

	WScript.Echo("")
	WScript.Echo("================================================================================")
	WScript.Echo("")

	WshShell.CurrentDirectory=".."
end function

' run the instance's tests across the apis
sub runapitests(instance, apis)
	dim api
	for each api in apis
		failures=failures+runapitest(instance,api)
	next
end sub

' run a wire-protocol test (the listener speaks another database's protocol)
function runprotocoltest(instance)

	dim dir, prog, server, cmd, args, result70, result74
	runprotocoltest=0

	' map the instance to its protocol test directory, test program, and
	' (for the tds variants, which share one test program built two ways -
	' see #9273) the server-name argument to pass on the command line
	dir=""
	prog=""
	server=""
	select case instance
		case "mysqlprotocol"
			dir="protocol\mysql"
			prog="mysql"
		case "postgresqlprotocol"
			dir="protocol\postgresql"
			prog="postgresql"
		case "tdsfreetdsmssqlprotocol"
			dir="protocol\tds"
			prog="tds-freetds"
		case "tdsfreetdssapprotocol"
			dir="protocol\tds"
			prog="tds-freetds"
			server="sqlrelaysap"
		case "tdssapprotocol"
			dir="protocol\tds"
			prog="tds-sap"
			server="sqlrelaysapct"
		case "oracleprotocol"
			dir="protocol\oracle"
			prog="oracle"
		case "teradataprotocol"
			dir="protocol\teradata"
			prog="teradata"
	end select

	WshShell.CurrentDirectory=dir
	if fso.FileExists(prog & ".exe") then

		' tdsfreetdsmssqlprotocol runs tds-freetds twice against the same
		' instance - once requesting tds 7.0 ([sqlrelay]) and once requesting
		' tds 7.4 ([sqlrelay74]) - #9199 - so both wire-shape variants get
		' covered.  both runs have to succeed for the instance to pass
		if instance="tdsfreetdsmssqlprotocol" then
			set cmd=WshShell.Exec(prog & ".exe sqlrelay")
			do until cmd.StdOut.AtEndOfStream
				WScript.Echo(cmd.StdOut.ReadLine())
			loop
			result70=cmd.ExitCode

			set cmd=WshShell.Exec(prog & ".exe sqlrelay74")
			do until cmd.StdOut.AtEndOfStream
				WScript.Echo(cmd.StdOut.ReadLine())
			loop
			result74=cmd.ExitCode

			if result70<>0 or result74<>0 then
				WScript.Echo(instance & " failed")
				runprotocoltest=1
			else
				WScript.Echo("test complete")
			end if
		else
			args=prog & ".exe"
			if server<>"" then
				args=args & " " & server
			end if
			set cmd=WshShell.Exec(args)
			do until cmd.StdOut.AtEndOfStream
				WScript.Echo(cmd.StdOut.ReadLine())
			loop
			if cmd.ExitCode<>0 then
				WScript.Echo(instance & " failed")
				runprotocoltest=1
			else
				WScript.Echo("test complete")
			end if
		end if
	else
		WScript.Echo("no test found for " & instance)
	end if
	WshShell.CurrentDirectory="..\.."
end function

' the crud test uses oracle-specific sql, so it runs only against oracle
function runcrudtest()

	dim cmd
	runcrudtest=0

	WshShell.CurrentDirectory="crud"
	if fso.FileExists("crud.exe") then
		set cmd=WshShell.Exec("crud.exe")
		do until cmd.StdOut.AtEndOfStream
			WScript.Echo(cmd.StdOut.ReadLine())
		loop
		if cmd.ExitCode<>0 then
			WScript.Echo("crud failed")
			runcrudtest=1
		else
			WScript.Echo("test complete")
		end if
	else
		WScript.Echo("no crud test found")
	end if
	WshShell.CurrentDirectory=".."
end function

' run the appropriate tests for an instance that is up
sub runinstancetests(instance, apis)

	WScript.Echo("")
	WScript.Echo("success...")
	WScript.Echo("")

	select case instance
		case "mysqlprotocol","postgresqlprotocol","tdsfreetdsmssqlprotocol","tdsfreetdssapprotocol","tdssapprotocol","oracleprotocol","teradataprotocol"
			failures=failures+runprotocoltest(instance)
		case else
			runapitests instance, apis

			' the crud test uses oracle-specific sql, so
			' run it only against the oracle instance
			if instance="oracle" then
				failures=failures+runcrudtest()
			end if
	end select
end sub


' --- main ---

' run with cscript
if instr(lcase(WScript.FullName),"cscript")=0 then
	WScript.Echo("Please run:  cscript /nologo test.vbs")
	WScript.Quit(1)
end if

' paths and objects
PREFIX="@prefix@"
set fso=CreateObject("Scripting.FileSystemObject")
set WshShell=WScript.CreateObject("WScript.Shell")

' local test config dir - this script lives in the test tree, so its own
' directory holds sqlrelay.conf.d.  load the per-instance config files from
' there with -config (like test.sh does), rather than the installed config.
CONFDIR=fso.GetParentFolderName(WScript.ScriptFullName) & "\sqlrelay.conf.d"

' get hostname
COMPUTERNAME=WshShell.ExpandEnvironmentStrings("%COMPUTERNAME%")

' parse the options
manage="yes"
dim args, i, np, positional()
set args=WScript.Arguments
np=0
redim positional(args.Count)
for i=0 to args.Count-1
	select case args(i)
		case "-n"
			manage="no"
		case "-h"
			usage
			WScript.Quit(0)
		case else
			if Left(args(i),1)="-" then
				usage
				WScript.Quit(1)
			end if
			positional(np)=args(i)
			np=np+1
	end select
next

' determine the set of instances to test
if np>=1 then
	testinstances=Split(collapsews(positional(0))," ")
else
	testinstances=Split(collapsews("@TESTINSTANCES@")," ")
end if

' determine the set of apis to test
if np>=2 then
	testapis=Split(collapsews(positional(1))," ")
else
	testapis=Split(collapsews("@TESTAPIS@")," ")
end if

' count of failures (instances that wouldn't start + tests that failed); the
' script exits non-zero if any, and never blocks waiting for input, so it can
' run unattended (eg. from make tests over ssh)
failures=0

' stop any existing instances
if manage="yes" then
	stopinstances
end if

' for each instance...
for each instance in testinstances

	' make sure that support for the appropriate database exists
	if not instanceapplicable(instance) then
		WScript.Echo("skipping " & instance & "...")
		WScript.Echo("")
		WScript.Echo("================================================================================")
		WScript.Echo("")
	else

		' testing...
		WScript.Echo("testing " & instance & " (from " & COMPUTERNAME & ")...")

		' start the instance and wait for it to come up
		up="yes"
		BYPASS="no"
		if manage="yes" then
			startinstance instance
			if pinginstance(instance) then
				up="yes"
			else
				up="no"
			end if
		end if

		' bypass the test if necessary
		if BYPASS<>"yes" then

			' run the tests
			if up="yes" then
				runinstancetests instance, testapis
			else
				WScript.Echo("")
				WScript.Echo("failed to start " & instance)
				WScript.Echo("")
				failures=failures+1
			end if
		end if

		' shut down the instance(s)
		if manage="yes" then
			stopinstance instance
		end if

		WScript.Echo("")
		WScript.Echo("================================================================================")
		WScript.Echo("")
	end if
next

' report and exit with a status the caller can check
WScript.Echo("")
if failures>0 then
	WScript.Echo(failures & " failure(s).")
	WScript.Quit(1)
else
	WScript.Echo("all tests passed.")
	WScript.Quit(0)
end if
