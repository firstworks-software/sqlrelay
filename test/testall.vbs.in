PREFIX="@prefix@"

' run with cscript
if instr(lcase(WScript.FullName),"cscript")=0 Then
	WScript.Echo("Please run:  cscript /nologo testall.vbs")
	WScript.Quit
end if

' dbs and apis to test
testdbs=Array(@TESTDBS@)
testapis=Array(@TESTAPIS@)

' count of failures (instances that wouldn't start + tests that failed); the
' script exits non-zero if any, and never blocks waiting for input, so it can
' run unattended (eg. from make tests over ssh)
failures=0

' create file system object
set fso=CreateObject("Scripting.FileSystemObject")

' local test config dir - this script lives in the test tree, so its own
' directory holds sqlrelay.conf.d.  load the per-db config files from there
' with -config (like testall.sh does), rather than the installed config.
CONFDIR=fso.GetParentFolderName(WScript.ScriptFullName) & "\sqlrelay.conf.d"

' create shell object
set WshShell=WScript.CreateObject("WScript.Shell")

' get hostname
COMPUTERNAME=WshShell.ExpandEnvironmentStrings("%COMPUTERNAME%")

' stop any existing instances
daemon "sqlr-stop", ""
WScript.Sleep(2000)

' for each database/configuration...
for each db in testdbs

	' testing...
	WScript.Echo("testing " & db & " (from " & COMPUTERNAME & ")...")

	' one instance at a time - all test instances share port 9000
	cleanslate()

	' for the router test, start the master/slave instances
	if db="router" then
		daemon "sqlr-start", "-config " & CONFDIR & "\" & db & ".conf -id routermaster"
		WScript.Sleep(2000)

		daemon "sqlr-start", "-config " & CONFDIR & "\" & db & ".conf -id routerslave"
		WScript.Sleep(2000)
	end if

	' start the instance
	daemon "sqlr-start", "-config " & CONFDIR & "\" & db & ".conf -id " & db & "test"
	WScript.Sleep(2000)

	' make sure that the instance is up
	PING=""
	for i=1 to 15

		WScript.Echo("")
		WScript.Echo("pinging " & db & "...")
		sqlrsh=""
		if db="extensions" then
			sqlrsh=PREFIX & "\bin\sqlrsh -host localhost -user test -password test -command ping"
		else
			sqlrsh=PREFIX & "\bin\sqlrsh -config " & CONFDIR & "\" & db & ".conf -id " & db & "test -command ping"
		end if
		set cmd=WshShell.Exec(sqlrsh)

		' get the output/error
		set re = new RegExp
		re.Pattern = "^\s*"
		re.Multiline = False
		PING=""
		do until cmd.StdOut.AtEndOfStream
			PING=PING & re.Replace(cmd.StdOut.ReadLine(),"")
		loop
		pingerr=""
		do until cmd.StdErr.AtEndOfStream
			pingerr=pingerr & re.Replace(cmd.StdErr.ReadLine(),"")
		loop

		Wscript.Echo(PING)
		Wscript.Echo(pingerr)

		if pingerr="0:Couldn't connect to the listener." then
			WScript.Sleep(5000)
		else
			exit for
		end if
	next

	' run the tests
	if PING="The database is up." then
		WScript.Echo("")
		WScript.Echo("success...")
		WScript.Echo("")
		for each api in testapis
			failures=failures+runapitest(db,api)
		next
	else
		WScript.Echo("")
		WScript.Echo("failed to start " & db & "test")
		WScript.Echo("")
		failures=failures+1
	end if

	' shut down the instance(s)
	if db="router" then
		WScript.Sleep(2000)
		daemon "sqlr-stop", "-config " & CONFDIR & "\" & db & ".conf -id routermaster"
		WScript.Sleep(2000)
		daemon "sqlr-stop", "-config " & CONFDIR & "\" & db & ".conf -id routerslave"
	end if
	WScript.Sleep(2000)
	daemon "sqlr-stop", "-config " & CONFDIR & "\" & db & ".conf -id " & db & "test"
	WScript.Sleep(2000)

	WScript.Echo("")
	WScript.Echo("================================================================================")
	WScript.Echo("")
next

' report and exit with a status the caller can check
WScript.Echo("")
if failures>0 then
	WScript.Echo(failures & " failure(s).")
	WScript.Quit(1)
else
	WScript.Echo("all tests passed.")
	WScript.Quit(0)
end if

' all test instances listen on port 9000, so only one runs at a time.  make
' sure the previous db's instance is fully gone and no stale pid files remain
' before starting the next - sqlr-stop is asynchronous and was sometimes too
' slow, leaving the next instance unable to come up ("failed to start").  #8484
sub cleanslate()
	WshShell.Run "taskkill /F /IM sqlr-listener.exe", 0, true
	WshShell.Run "taskkill /F /IM sqlr-connection.exe", 0, true
	WScript.Sleep 500
	WshShell.Run "cmd /c del /q " & Chr(34) & PREFIX & "\var\run\sqlrelay\*" & Chr(34), 0, true
end sub

' start or stop a sqlrelay daemon so its spawned listener/connection outlive
' this script.  Exec would kill them via its job object when the WshScriptExec
' is released; Run does not, and needs the exe path quoted (it has a space).
' #8484
sub daemon(prog, args)
	WshShell.Run Chr(34) & PREFIX & "\bin\" & prog & Chr(34) & " " & args, 0, false
end sub

function runapitest(db,api)

	' default to success; set to 1 below if the test fails
	runapitest=0

	WScript.echo("testing in " & api)
	WScript.echo("")
	WshShell.CurrentDirectory=api 

	TEST=""
	TESTFILE=""
	select case api
		case "c"
			TEST=db & ".exe"
			TESTFILE=db & ".exe"
		case "c++"
			TEST=db & ".exe"
			TESTFILE=db & ".exe"
		case "cs"
			TEST=db & ".exe"
			TESTFILE=db & ".exe"
		case "java"
			TEST="run.bat " & db
			TESTFILE=db & ".class"
		case "jdbc"
			TEST="run.bat " & db
			TESTFILE=db & ".class"
		case "nodejs"
			TEST="node " & db & ".js"
			TESTFILE=db & ".js"
		case "perl"
			TEST="perl " & db & ".pl"
			TESTFILE=db & ".pl"
		case "perldbi"
			TEST="perl " & db & ".pl"
			TESTFILE=db & ".pl"
		case "php"
			TEST="php " & db & ".php"
			TESTFILE=db & ".php"
		case "phppdo"
			TEST="php " & db & ".php"
			TESTFILE=db & ".php"
		case "python"
			TEST="python " & db & ".py"
			TESTFILE=db & ".py"
		case "pythondb"
			TEST="python " & db & ".py"
			TESTFILE=db & ".py"
		case "ruby"
			TEST="ruby " & db & ".rb"
			TESTFILE=db & ".rb"
		case "tcl"
			TEST="tclsh " & db & ".tcl"
			TESTFILE=db & ".tcl"
	end select

	if fso.FileExists(TESTFILE) then
		set cmd=WshShell.Exec(TEST)
		do until cmd.StdOut.AtEndOfStream
			WScript.Echo(cmd.StdOut.ReadLine())
		loop
		' any non-zero exit is a failure.  the tests return 1 on a failed
		' assertion, but a crashed test exits with a code like 0xC0000005,
		' not 1, so checking =1 alone would let a crash pass as success.
		if cmd.ExitCode<>0 then
			WScript.echo("")
			WScript.echo("")
			WScript.echo(db & " failed in " & api)
			runapitest=1
		else
			WScript.echo("")
			WScript.echo("test complete")
		end if
	else
		WScript.echo("no test found for " & db & " in " & api)
	end if

	WScript.echo("")
	WScript.echo("================================================================================")
	WScript.echo("")

	WshShell.CurrentDirectory=".."
end function
