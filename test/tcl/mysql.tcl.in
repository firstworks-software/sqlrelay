# rebinding
puts "REBINDING: "
catch {$cur sendQuery "drop procedure testproc"}
assertTrue [$cur sendQuery "create procedure testproc(in in1 int) begin select in1; end"]
$cur prepareQuery "call testproc(?)"
$cur inputBind "1" 1
assertTrue [$cur executeQuery]
assertEqual [$cur getFieldByIndex 0 0] "1"
$cur inputBind "1" 2
assertTrue [$cur executeQuery]
assertEqual [$cur getFieldByIndex 0 0] "2"
$cur inputBind "1" 3
assertTrue [$cur executeQuery]
assertEqual [$cur getFieldByIndex 0 0] "3"
assertTrue [$cur sendQuery "drop procedure testproc"]
puts ""


