assertEqual [$cur getColumnTypeByName "testtime"] "TIME"
assertEqual [$cur getColumnTypeByName "testdatetime"] "DATETIME"
assertEqual [$cur getColumnTypeByName "testyear"] "YEAR"
if {$majorversion==3} {
	assertEqual [$cur getColumnTypeByName "testchar"] "VARSTRING"
} else {
	assertEqual [$cur getColumnTypeByName "testchar"] "STRING"
}
assertEqual [$cur getColumnTypeByName "testvarchar"] "VARSTRING"
assertEqual [$cur getColumnTypeByName "testtext"] "BLOB"
assertEqual [$cur getColumnTypeByName "testtinytext"] "TINYBLOB"
assertEqual [$cur getColumnTypeByName "testmediumtext"] "MEDIUMBLOB"
assertEqual [$cur getColumnTypeByName "testlongtext"] "LONGBLOB"
assertEqual [$cur getColumnTypeByName "testblob"] "BLOB"
assertEqual [$cur getColumnTypeByName "testtinyblob"] "TINYBLOB"
assertEqual [$cur getColumnTypeByName "testmediumblob"] "MEDIUMBLOB"
assertEqual [$cur getColumnTypeByName "testlongblob"] "LONGBLOB"
assertEqual [$cur getColumnTypeByName "testtimestamp"] "TIMESTAMP"
puts ""


# column length
puts "COLUMN LENGTH: "
assertEqual [$cur getColumnLengthByIndex 0] 1
assertEqual [$cur getColumnLengthByIndex 1] 2
assertEqual [$cur getColumnLengthByIndex 2] 3
