# quotes - random - '',\-escaped
puts "QUOTES - random - '',\\-escaped: "
catch {$cur sendQuery "drop table testtable"}
assertTrue [$cur sendQuery "create table testtable (col1 varchar(512))"]
set chars [list "'" "\"" "\\" "\x00"]
set buffer ""
for {set j 0} {$j<256} {incr j} {
	set idx [expr {int(rand()*4)}]
	append buffer [lindex $chars $idx]
}
set query [binary format a* "insert into testtable values ('"]
for {set j 0} {$j<256} {incr j} {
	set ch [string index $buffer $j]
	if {$ch eq "'"} {
		# randomly escape with \ or ''
		if {int(rand()*2)} {
			append query "'"
		} else {
			append query "\\"
		}
	}
	if {$ch eq "\""} {
		# randomly escape with \ or don't escape
		if {int(rand()*2)} {
			append query "\\"
		}
	}
	if {$ch eq "\\"} {
		# escape with backslash
		append query "\\"
	}
	append query $ch
}
append query [binary format a* "')"]
assertTrue [$cur sendQueryWithLength $query [string length $query]]
assertTrue [$cur sendQuery "select col1 from testtable"]
assertEqual [$cur getFieldLengthByIndex 0 0] 256
assertEqual [binary encode hex [$cur getFieldByIndex 0 0]] [binary encode hex $buffer]
assertTrue [$cur sendQuery "drop table testtable"]
puts ""


