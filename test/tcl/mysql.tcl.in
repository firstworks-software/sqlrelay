# longest column
puts "LONGEST COLUMN: "
assertEqual [$cur getLongestByIndex 0] 1
assertEqual [$cur getLongestByIndex 1] 1
assertEqual [$cur getLongestByIndex 2] 1
assertEqual [$cur getLongestByIndex 3] 1
assertEqual [$cur getLongestByIndex 4] 1
