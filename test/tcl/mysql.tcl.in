assertEqual [$cur getColumnLengthByIndex 13] 65535
#assertEqual [$cur getColumnLengthByIndex 14] 41
assertEqual [$cur getColumnLengthByIndex 15] 255
assertEqual [$cur getColumnLengthByIndex 16] 16777215
assertEqual [$cur getColumnLengthByIndex 17] 2147483647
assertEqual [$cur getColumnLengthByIndex 18] 4
assertEqual [$cur getColumnLengthByName "testtinyint"] 1
assertEqual [$cur getColumnLengthByName "testsmallint"] 2
assertEqual [$cur getColumnLengthByName "testmediumint"] 3
assertEqual [$cur getColumnLengthByName "testint"] 4
assertEqual [$cur getColumnLengthByName "testbigint"] 8
assertEqual [$cur getColumnLengthByName "testfloat"] 4
assertEqual [$cur getColumnLengthByName "testreal"] 8
assertEqual [$cur getColumnLengthByName "testdecimal"] 6
assertEqual [$cur getColumnLengthByName "testdate"] 3
assertEqual [$cur getColumnLengthByName "testtime"] 3
assertEqual [$cur getColumnLengthByName "testdatetime"] 8
assertEqual [$cur getColumnLengthByName "testyear"] 1
#assertEqual [$cur getColumnLengthByName "testchar"] 40
assertEqual [$cur getColumnLengthByName "testtext"] 65535
#assertEqual [$cur getColumnLengthByName "testvarchar"] 41
assertEqual [$cur getColumnLengthByName "testtinytext"] 255
assertEqual [$cur getColumnLengthByName "testmediumtext"] 16777215
assertEqual [$cur getColumnLengthByName "testlongtext"] 2147483647
assertEqual [$cur getColumnLengthByName "testtimestamp"] 4
puts ""


# longest column
puts "LONGEST COLUMN: "
assertEqual [$cur getLongestByIndex 0] 1
assertEqual [$cur getLongestByIndex 1] 1
assertEqual [$cur getLongestByIndex 2] 1
assertEqual [$cur getLongestByIndex 3] 1
assertEqual [$cur getLongestByIndex 4] 1
#assertEqual [$cur getLongestByIndex 5] 3
assertEqual [$cur getLongestByIndex 6] 3
assertEqual [$cur getLongestByIndex 7] 3
assertEqual [$cur getLongestByIndex 8] 10
assertEqual [$cur getLongestByIndex 9] 8
assertEqual [$cur getLongestByIndex 10] 19
