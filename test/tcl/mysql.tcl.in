assertFalse [expr {[string first "auto_increment" [$cur getFieldByName 1 "extra"]] != -1}]
assertFalse [expr {[string first "PRI" [$cur getFieldByName 1 "column_key"]] != -1}]
puts ""
assertTrue [$cur sendQuery "drop table testtable"]
assertTrue [$cur sendQuery "create table testtable (col1 int primary key, col2 int)"]
assertTrue [$cur getColumnList "testtable" ""]
assertFalse [expr {[string first "auto_increment" [$cur getFieldByName 0 "extra"]] != -1}]
assertTrue [expr {[string first "PRI" [$cur getFieldByName 0 "column_key"]] != -1}]
assertTrue [$cur sendQuery "drop table testtable"]
puts ""


# primary keys list
