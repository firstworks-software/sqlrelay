assertEqual [$cur getLongestByIndex 14] 8
assertEqual [$cur getLongestByIndex 15] 9
assertEqual [$cur getLongestByIndex 16] 11
assertEqual [$cur getLongestByIndex 17] 9
if {$majorversion == 3} {
	assertEqual [$cur getLongestByIndex 18] 14
} else {
	assertEqual [$cur getLongestByIndex 18] 19
}
assertEqual [$cur getLongestByName "testtinyint"] 1
assertEqual [$cur getLongestByName "testsmallint"] 1
assertEqual [$cur getLongestByName "testmediumint"] 1
assertEqual [$cur getLongestByName "testint"] 1
assertEqual [$cur getLongestByName "testbigint"] 1
#assertEqual [$cur getLongestByName "testfloat"] 3
assertEqual [$cur getLongestByName "testreal"] 3
assertEqual [$cur getLongestByName "testdecimal"] 3
assertEqual [$cur getLongestByName "testdate"] 10
assertEqual [$cur getLongestByName "testtime"] 8
assertEqual [$cur getLongestByName "testdatetime"] 19
assertEqual [$cur getLongestByName "testyear"] 4
assertEqual [$cur getLongestByName "testchar"] 5
assertEqual [$cur getLongestByName "testtext"] 5
assertEqual [$cur getLongestByName "testvarchar"] 8
assertEqual [$cur getLongestByName "testtinytext"] 9
assertEqual [$cur getLongestByName "testmediumtext"] 11
assertEqual [$cur getLongestByName "testlongtext"] 9
if {$majorversion == 3} {
	assertEqual [$cur getLongestByName "testtimestamp"] 14
} else {
	assertEqual [$cur getLongestByName "testtimestamp"] 19
}
puts ""


# row count
puts "ROW COUNT: "
assertEqual [$cur rowCount] 8
puts ""


# total rows
puts "TOTAL ROWS: "
# older versions of mysql know this
#assertEqual [$cur totalRows] 0
puts ""


# first row index
puts "FIRST ROW INDEX: "
assertEqual [$cur firstRowIndex] 0
puts ""


# end of result set
puts "END OF RESULT SET: "
assertTrue [$cur endOfResultSet]
puts ""


# fields by index
puts "FIELDS BY INDEX: "
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 0 1] "1"
assertEqual [$cur getFieldByIndex 0 2] "1"
