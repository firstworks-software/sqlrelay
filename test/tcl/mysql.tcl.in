if {$majorversion>3} {

	# stored procedure returning no value
	puts "STORED PROCEDURE RETURNING NO VALUE: "
	catch {$cur sendQuery "drop procedure if exists testproc"}
	assertTrue [$cur sendQuery "create procedure testproc(in in1 int, in in2 float, in in3 char(20)) begin select in1, in2, in3; end;"]
	$cur prepareQuery "call testproc(?,?,?)"
	$cur inputBind "1" 1
	$cur inputBind "2" 1.1 4 2
	$cur inputBind "3" "hello"
	assertTrue [$cur executeQuery]
	assertEqual [$cur getFieldByIndex 0 0] "1"
	assertEqual [$cur getFieldByIndex 0 1] "1.1"
	assertEqual [$cur getFieldByIndex 0 2] "hello"
	catch {$cur sendQuery "drop procedure testproc"}
	puts ""


	# stored procedure returning one value
	puts "FUNCTIONS: "
	catch {$cur sendQuery "drop function if exists testfunc"}
	assertTrue [$cur sendQuery "create function testfunc(in1 int, in2 int) returns int return in1+in2;"]
	$cur prepareQuery "select testfunc(?,?)"
	$cur inputBind "1" 10
	$cur inputBind "2" 20
	assertTrue [$cur executeQuery]
	assertEqual [$cur getFieldByIndex 0 0] "30"
	catch {$cur sendQuery "drop function if exists testfunc"}
	puts ""


	# stored procedure returning multiple values
	puts "STORED PROCEDURE RETURNING MULTIPLE VALUES: "
	catch {$cur sendQuery "drop procedure if exists testproc"}
	assertTrue [$cur sendQuery "create procedure testproc(out out1 int, out out2 float, out out3 char(20)) begin select 1, 1.1, 'hello' into out1, out2, out3; end;"]
	assertTrue [$cur sendQuery "set @out1=0, @out2=0.0, @out3=''"]
	assertTrue [$cur sendQuery "call testproc(@out1,@out2,@out3)"]
	assertTrue [$cur sendQuery "select @out1, @out2, @out3"]
	assertEqual [$cur getFieldByIndex 0 0] "1"
	#assertEqual [$cur getFieldAsDoubleByIndex 0 1] 1.1
	assertEqual [$cur getFieldByIndex 0 2] "hello"
	catch {$cur sendQuery "drop procedure testproc"}
	puts ""


	# stored procedure returning result set
	puts "STORED PROCEDURE RETURNING RESULT SET: "
	catch {$cur sendQuery "drop procedure if exists testselectproc"}
	assertTrue [$cur sendQuery "create procedure testselectproc() begin select 1 union select 2 union select 3 union select 4 union select 5 union select 6 union select 7 union select 8; end"]
	assertTrue [$cur sendQuery "call testselectproc()"]
	assertEqual [$cur rowCount] 8
	catch {$cur sendQuery "drop procedure testselectproc"}
	puts ""
}


if {$majorversion>3} {

	# encoded binary data - all chars - \-escaped
	puts "ENCODED BINARY DATA - all chars - \\-escaped: "
	catch {$cur sendQuery "drop table testtable"}
	assertTrue [$cur sendQuery "create table testtable (col1 longblob)"]
	set buffer ""
	for {set j 0} {$j<256} {incr j} {
		append buffer [binary format c $j]
	}
	set query [binary format a* "insert into testtable values (_binary'"]
	for {set j 0} {$j<256} {incr j} {
		set ch [string index $buffer $j]
		if {$ch eq "'"} {
			append query "\\"
		}
		if {$ch eq "\\"} {
			append query "\\"
		}
		append query $ch
	}
	append query [binary format a* "')"]
	assertTrue [$cur sendQueryWithLength $query [string length $query]]
	assertTrue [$cur sendQuery "select col1 from testtable"]
	assertEqual [$cur getFieldLengthByIndex 0 0] 256
	assertEqual [binary encode hex [$cur getFieldByIndex 0 0]] [binary encode hex $buffer]
	assertTrue [$cur sendQuery "drop table testtable"]
	puts ""


	# encoded binary data - (null)"" - unescaped
	puts "ENCODED BINARY DATA - (null)\"\" - unescaped: "
	catch {$cur sendQuery "drop table testtable"}
	assertTrue [$cur sendQuery "create table testtable (col1 longblob)"]
	set binbuf [binary format a3 "\x00\"\""]
	set query [binary format a* "insert into testtable values (_binary'"]
	append query $binbuf
	append query [binary format a* "')"]
	assertTrue [$cur sendQueryWithLength $query [string length $query]]
	assertTrue [$cur sendQuery "select col1 from testtable"]
	assertEqual [$cur getFieldLengthByIndex 0 0] 3
	assertEqual [binary encode hex [$cur getFieldByIndex 0 0]] [binary encode hex $binbuf]
	assertTrue [$cur sendQuery "drop table testtable"]
	puts ""


	# encoded binary data - (null)"" - \-escaped
	puts "ENCODED BINARY DATA - \\(null)\\\"\\\" - \\-escaped: "
	catch {$cur sendQuery "drop table testtable"}
	assertTrue [$cur sendQuery "create table testtable (col1 longblob)"]
	set binbuf [binary format a3 "\x00\"\""]
	set query [binary format a* "insert into testtable values (_binary'"]
	append query "\\"
	append query [string index $binbuf 0]
	append query "\\"
	append query [string index $binbuf 1]
	append query "\\"
	append query [string index $binbuf 2]
	append query [binary format a* "')"]
	assertTrue [$cur sendQueryWithLength $query [string length $query]]
	assertTrue [$cur sendQuery "select col1 from testtable"]
	assertEqual [$cur getFieldLengthByIndex 0 0] 3
	assertEqual [binary encode hex [$cur getFieldByIndex 0 0]] [binary encode hex $binbuf]
	assertTrue [$cur sendQuery "drop table testtable"]
	puts ""
}


