load @TCLLIBSPATH@@SLASH@sqlrelay@SLASH@sqlrelay.@SOSUFFIX@ sqlrelay
source ./asserts.tcl

# instantiation
set con [sqlrcon -server "sqlrelay" -port 9000 -socket "/tmp/test.socket" -user "db2inst1" -password "testpassword" -retrytime 0 -tries 1]
set cur [$con sqlrcur]

# get database type
puts "IDENTIFY: "
assertEqual [$con identify] "db2"
puts ""

# ping
puts "PING: "
assertTrue [$con ping]
puts ""

# isolation levels
puts "ISOLATION LEVELS: "
set isolationlevels [list "CS" "UR" "RS" "RR"]
foreach il $isolationlevels {
	assertTrue [$con setIsolationLevel $il]
	assertEqual [$con getIsolationLevel] $il
	puts ""
}
# reset to the default isolation level
assertTrue [$con setIsolationLevel [lindex $isolationlevels 0]]
puts ""

# drop existing table
catch {$cur sendQuery "drop table testtable"}

puts "CREATE TEMPTABLE: "
assertTrue [$cur sendQuery "create table testtable (testsmallint smallint, testint integer, testbigint bigint, testdecimal decimal(10,2), testreal real, testdouble double, testchar char(40), testvarchar varchar(40), testdate date, testtime time, testtimestamp timestamp)"]
puts ""

puts "INSERT: "
assertTrue [$cur sendQuery "insert into testtable values (1,1,1,1.1,1.1,1.1,'testchar1','testvarchar1','01/01/2001','01:00:00',NULL)"]
puts ""

puts "BIND BY POSITION: "
$cur prepareQuery "insert into testtable values (?,?,?,?,?,?,?,?,?,?,NULL)"
assertEqual [$cur countBindVariables] 10
$cur inputBind "1" 2
$cur inputBind "2" 2
$cur inputBind "3" 2
$cur inputBind "4" 2.2 4 2
$cur inputBind "5" 2.2 4 2
$cur inputBind "6" 2.2 4 2
$cur inputBind "7" "testchar2"
$cur inputBind "8" "testvarchar2"
$cur inputBind "9" "01/01/2002"
$cur inputBind "10" "02:00:00"
assertTrue [$cur executeQuery]
$cur clearBinds 
$cur inputBind "1" 3
$cur inputBind "2" 3
$cur inputBind "3" 3
$cur inputBind "4" 3.3 4 2
$cur inputBind "5" 3.3 4 2
$cur inputBind "6" 3.3 4 2
$cur inputBind "7" "testchar3"
$cur inputBind "8" "testvarchar3"
$cur inputBind "9" "01/01/2003"
$cur inputBind "10" "03:00:00"
assertTrue [$cur executeQuery]
puts ""

puts "ARRAY OF BINDS BY POSITION: "
$cur clearBinds 
$cur inputBinds {{"1" 4} {"2" 4} {"3" 4} {"4" 4.4 4 2} {"5" 4.4 4 2} {"6" 4.4 4 2} {"7" "testchar4"} {"8" "testvarchar4"} {"9" "01/01/2004"} {"10" "04:00:00"}}
assertTrue [$cur executeQuery]
puts ""

puts "INSERT: "
assertTrue [$cur sendQuery "insert into testtable values (5,5,5,5.5,5.5,5.5,'testchar5','testvarchar5','01/01/2005','05:00:00',NULL)"]
assertTrue [$cur sendQuery "insert into testtable values (6,6,6,6.6,6.6,6.6,'testchar6','testvarchar6','01/01/2006','06:00:00',NULL)"]
assertTrue [$cur sendQuery "insert into testtable values (7,7,7,7.7,7.7,7.7,'testchar7','testvarchar7','01/01/2007','07:00:00',NULL)"]
assertTrue [$cur sendQuery "insert into testtable values (8,8,8,8.8,8.8,8.8,'testchar8','testvarchar8','01/01/2008','08:00:00',NULL)"]
puts ""

puts "AFFECTED ROWS: "
assertEqual [$cur affectedRows] 1
puts ""

puts "STORED PROCEDURE: "
catch {$cur sendQuery "drop procedure testproc"}
assertTrue [$cur sendQuery "create procedure testproc(in invar int, out outvar int) language sql begin set outvar = invar; end"]
$cur prepareQuery "call testproc(?,?)"
$cur inputBind "1" 5
$cur defineOutputBindString "2" 10
assertTrue [$cur executeQuery]
assertEqual [$cur getOutputBindString "2"] "5"
assertTrue [$cur sendQuery "drop procedure testproc"]
puts ""

puts "SELECT: "
assertTrue [$cur sendQuery "select * from testtable order by testsmallint"]
puts ""

puts "COLUMN COUNT: "
assertEqual [$cur colCount] 11
puts ""

puts "COLUMN NAMES: "
assertEqual [$cur getColumnName 0] "TESTSMALLINT"
assertEqual [$cur getColumnName 1] "TESTINT"
assertEqual [$cur getColumnName 2] "TESTBIGINT"
assertEqual [$cur getColumnName 3] "TESTDECIMAL"
assertEqual [$cur getColumnName 4] "TESTREAL"
assertEqual [$cur getColumnName 5] "TESTDOUBLE"
assertEqual [$cur getColumnName 6] "TESTCHAR"
assertEqual [$cur getColumnName 7] "TESTVARCHAR"
assertEqual [$cur getColumnName 8] "TESTDATE"
assertEqual [$cur getColumnName 9] "TESTTIME"
assertEqual [$cur getColumnName 10] "TESTTIMESTAMP"
set cols [$cur getColumnNames]
assertEqual [lindex $cols 0] "TESTSMALLINT"
assertEqual [lindex $cols 1] "TESTINT"
assertEqual [lindex $cols 2] "TESTBIGINT"
assertEqual [lindex $cols 3] "TESTDECIMAL"
assertEqual [lindex $cols 4] "TESTREAL"
assertEqual [lindex $cols 5] "TESTDOUBLE"
assertEqual [lindex $cols 6] "TESTCHAR"
assertEqual [lindex $cols 7] "TESTVARCHAR"
assertEqual [lindex $cols 8] "TESTDATE"
assertEqual [lindex $cols 9] "TESTTIME"
assertEqual [lindex $cols 10] "TESTTIMESTAMP"
puts ""

puts "COLUMN TYPES: "
assertEqual [$cur getColumnTypeByIndex 0] "SMALLINT"
assertEqual [$cur getColumnTypeByName "TESTSMALLINT"] "SMALLINT"
assertEqual [$cur getColumnTypeByIndex 1] "INTEGER"
assertEqual [$cur getColumnTypeByName "TESTINT"] "INTEGER"
assertEqual [$cur getColumnTypeByIndex 2] "BIGINT"
assertEqual [$cur getColumnTypeByName "TESTBIGINT"] "BIGINT"
assertEqual [$cur getColumnTypeByIndex 3] "DECIMAL"
assertEqual [$cur getColumnTypeByName "TESTDECIMAL"] "DECIMAL"
assertEqual [$cur getColumnTypeByIndex 4] "REAL"
assertEqual [$cur getColumnTypeByName "TESTREAL"] "REAL"
assertEqual [$cur getColumnTypeByIndex 5] "DOUBLE"
assertEqual [$cur getColumnTypeByName "TESTDOUBLE"] "DOUBLE"
assertEqual [$cur getColumnTypeByIndex 6] "CHAR"
assertEqual [$cur getColumnTypeByName "TESTCHAR"] "CHAR"
assertEqual [$cur getColumnTypeByIndex 7] "VARCHAR"
assertEqual [$cur getColumnTypeByName "TESTVARCHAR"] "VARCHAR"
assertEqual [$cur getColumnTypeByIndex 8] "DATE"
assertEqual [$cur getColumnTypeByName "TESTDATE"] "DATE"
assertEqual [$cur getColumnTypeByIndex 9] "TIME"
assertEqual [$cur getColumnTypeByName "TESTTIME"] "TIME"
assertEqual [$cur getColumnTypeByIndex 10] "TIMESTAMP"
assertEqual [$cur getColumnTypeByName "TESTTIMESTAMP"] "TIMESTAMP"
puts ""

puts "COLUMN LENGTH: "
assertEqual [$cur getColumnLengthByIndex 0] 2
assertEqual [$cur getColumnLengthByName "TESTSMALLINT"] 2
assertEqual [$cur getColumnLengthByIndex 1] 4
assertEqual [$cur getColumnLengthByName "TESTINT"] 4
assertEqual [$cur getColumnLengthByIndex 2] 8
assertEqual [$cur getColumnLengthByName "TESTBIGINT"] 8
assertEqual [$cur getColumnLengthByIndex 3] 12
assertEqual [$cur getColumnLengthByName "TESTDECIMAL"] 12
assertEqual [$cur getColumnLengthByIndex 4] 4
assertEqual [$cur getColumnLengthByName "TESTREAL"] 4
assertEqual [$cur getColumnLengthByIndex 5] 8
assertEqual [$cur getColumnLengthByName "TESTDOUBLE"] 8
assertEqual [$cur getColumnLengthByIndex 6] 40
assertEqual [$cur getColumnLengthByName "TESTCHAR"] 40
assertEqual [$cur getColumnLengthByIndex 7] 40
assertEqual [$cur getColumnLengthByName "TESTVARCHAR"] 40
assertEqual [$cur getColumnLengthByIndex 8] 6
assertEqual [$cur getColumnLengthByName "TESTDATE"] 6
assertEqual [$cur getColumnLengthByIndex 9] 6
assertEqual [$cur getColumnLengthByName "TESTTIME"] 6
assertEqual [$cur getColumnLengthByIndex 10] 16
assertEqual [$cur getColumnLengthByName "TESTTIMESTAMP"] 16
puts ""

puts "LONGEST COLUMN: "
assertEqual [$cur getLongestByIndex 0] 1
assertEqual [$cur getLongestByName "TESTSMALLINT"] 1
assertEqual [$cur getLongestByIndex 1] 1
assertEqual [$cur getLongestByName "TESTINT"] 1
assertEqual [$cur getLongestByIndex 2] 1
assertEqual [$cur getLongestByName "TESTBIGINT"] 1
assertEqual [$cur getLongestByIndex 3] 4
assertEqual [$cur getLongestByName "TESTDECIMAL"] 4
#assertEqual [$cur getLongestByIndex 4] 3
#assertEqual [$cur getLongestByName "TESTREAL"] 3
#assertEqual [$cur getLongestByIndex 5] 3
#assertEqual [$cur getLongestByName "TESTDOUBLE"] 3
assertEqual [$cur getLongestByIndex 6] 40
assertEqual [$cur getLongestByName "TESTCHAR"] 40
assertEqual [$cur getLongestByIndex 7] 12
assertEqual [$cur getLongestByName "TESTVARCHAR"] 12
assertEqual [$cur getLongestByIndex 8] 10
assertEqual [$cur getLongestByName "TESTDATE"] 10
assertEqual [$cur getLongestByIndex 9] 8
assertEqual [$cur getLongestByName "TESTTIME"] 8
puts ""

puts "ROW COUNT: "
assertEqual [$cur rowCount] 8
puts ""

puts "TOTAL ROWS: "
assertEqual [$cur totalRows] 0
puts ""

puts "FIRST ROW INDEX: "
assertEqual [$cur firstRowIndex] 0
puts ""

puts "END OF RESULT SET: "
assertTrue [$cur endOfResultSet]
puts ""

puts "FIELDS BY INDEX: "
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 0 1] "1"
assertEqual [$cur getFieldByIndex 0 2] "1"
assertEqual [$cur getFieldByIndex 0 3] "1.10"
#assertEqual [$cur getFieldByIndex 0 4] "1.1"
#assertEqual [$cur getFieldByIndex 0 5] "1.1"
assertEqual [$cur getFieldByIndex 0 6] "testchar1                               "
assertEqual [$cur getFieldByIndex 0 7] "testvarchar1"
assertEqual [$cur getFieldByIndex 0 8] "2001-01-01"
assertEqual [$cur getFieldByIndex 0 9] "01:00:00"
puts ""
assertEqual [$cur getFieldByIndex 7 0] "8"
assertEqual [$cur getFieldByIndex 7 1] "8"
assertEqual [$cur getFieldByIndex 7 2] "8"
assertEqual [$cur getFieldByIndex 7 3] "8.80"
#assertEqual [$cur getFieldByIndex 7 4] "8.8"
#assertEqual [$cur getFieldByIndex 7 5] "8.8"
assertEqual [$cur getFieldByIndex 7 6] "testchar8                               "
assertEqual [$cur getFieldByIndex 7 7] "testvarchar8"
assertEqual [$cur getFieldByIndex 7 8] "2008-01-01"
assertEqual [$cur getFieldByIndex 7 9] "08:00:00"
puts ""

puts "FIELD LENGTHS BY INDEX: "
assertEqual [$cur getFieldLengthByIndex 0 0] 1
assertEqual [$cur getFieldLengthByIndex 0 1] 1
assertEqual [$cur getFieldLengthByIndex 0 2] 1
assertEqual [$cur getFieldLengthByIndex 0 3] 4
#assertEqual [$cur getFieldLengthByIndex 0 4] 3
#assertEqual [$cur getFieldLengthByIndex 0 5 3
assertEqual [$cur getFieldLengthByIndex 0 6] 40
assertEqual [$cur getFieldLengthByIndex 0 7] 12
assertEqual [$cur getFieldLengthByIndex 0 8] 10
assertEqual [$cur getFieldLengthByIndex 0 9] 8
puts ""
assertEqual [$cur getFieldLengthByIndex 7 0] 1
assertEqual [$cur getFieldLengthByIndex 7 1] 1
assertEqual [$cur getFieldLengthByIndex 7 2] 1
assertEqual [$cur getFieldLengthByIndex 7 3] 4
#assertEqual [$cur getFieldLengthByIndex 7 4] 3
#assertEqual [$cur getFieldLengthByIndex 7 5] 3
assertEqual [$cur getFieldLengthByIndex 7 6] 40
assertEqual [$cur getFieldLengthByIndex 7 7] 12
assertEqual [$cur getFieldLengthByIndex 7 8] 10
assertEqual [$cur getFieldLengthByIndex 7 9] 8
puts ""

puts "FIELDS BY NAME: "
assertEqual [$cur getFieldByName 0 "TESTSMALLINT"] "1"
assertEqual [$cur getFieldByName 0 "TESTINT"] "1"
assertEqual [$cur getFieldByName 0 "TESTBIGINT"] "1"
assertEqual [$cur getFieldByName 0 "TESTDECIMAL"] "1.10"
#assertEqual [$cur getFieldByName 0 "TESTREAL"] "1.1"
#assertEqual [$cur getFieldByName 0 "TESTDOUBLE"] "1.1"
assertEqual [$cur getFieldByName 0 "TESTCHAR"] "testchar1                               "
assertEqual [$cur getFieldByName 0 "TESTVARCHAR"] "testvarchar1"
assertEqual [$cur getFieldByName 0 "TESTDATE"] "2001-01-01"
assertEqual [$cur getFieldByName 0 "TESTTIME"] "01:00:00"
puts ""
assertEqual [$cur getFieldByName 7 "TESTSMALLINT"] "8"
assertEqual [$cur getFieldByName 7 "TESTINT"] "8"
assertEqual [$cur getFieldByName 7 "TESTBIGINT"] "8"
assertEqual [$cur getFieldByName 7 "TESTDECIMAL"] "8.80"
#assertEqual [$cur getFieldByName 7 "TESTREAL"] "8.8"
#assertEqual [$cur getFieldByName 7 "TESTDOUBLE"] "8.8"
assertEqual [$cur getFieldByName 7 "TESTCHAR"] "testchar8                               "
assertEqual [$cur getFieldByName 7 "TESTVARCHAR"] "testvarchar8"
assertEqual [$cur getFieldByName 7 "TESTDATE"] "2008-01-01"
assertEqual [$cur getFieldByName 7 "TESTTIME"] "08:00:00"
puts ""

puts "FIELD LENGTHS BY NAME: "
assertEqual [$cur getFieldLengthByName 0 "TESTSMALLINT"] 1
assertEqual [$cur getFieldLengthByName 0 "TESTINT"] 1
assertEqual [$cur getFieldLengthByName 0 "TESTBIGINT"] 1
assertEqual [$cur getFieldLengthByName 0 "TESTDECIMAL"] 4
#assertEqual [$cur getFieldLengthByName 0 "TESTREAL"] 3
#assertEqual [$cur getFieldLengthByName 0 "TESTDOUBLE"] 3
assertEqual [$cur getFieldLengthByName 0 "TESTCHAR"] 40
assertEqual [$cur getFieldLengthByName 0 "TESTVARCHAR"] 12
assertEqual [$cur getFieldLengthByName 0 "TESTDATE"] 10
assertEqual [$cur getFieldLengthByName 0 "TESTTIME"] 8
puts ""
assertEqual [$cur getFieldLengthByName 7 "TESTSMALLINT"] 1
assertEqual [$cur getFieldLengthByName 7 "TESTINT"] 1
assertEqual [$cur getFieldLengthByName 7 "TESTBIGINT"] 1
assertEqual [$cur getFieldLengthByName 7 "TESTDECIMAL"] 4
#assertEqual [$cur getFieldLengthByName 7 "TESTREAL"] 3
#assertEqual [$cur getFieldLengthByName 7 "TESTDOUBLE"] 3
assertEqual [$cur getFieldLengthByName 7 "TESTCHAR"] 40
assertEqual [$cur getFieldLengthByName 7 "TESTVARCHAR"] 12
assertEqual [$cur getFieldLengthByName 7 "TESTDATE"] 10
assertEqual [$cur getFieldLengthByName 7 "TESTTIME"] 8
puts ""

puts "FIELDS BY ARRAY: "
set fields [$cur getRow 0]
assertEqual [lindex $fields 0] 1
assertEqual [lindex $fields 1] 1
assertEqual [lindex $fields 2] 1
assertEqual [lindex $fields 3] 1.1
assertEqual [lindex $fields 4] 1.1
assertEqual [lindex $fields 5] 1.1
assertEqual [lindex $fields 6] "testchar1                               "
assertEqual [lindex $fields 7] "testvarchar1"
assertEqual [lindex $fields 8] "2001-01-01"
assertEqual [lindex $fields 9] "01:00:00"
puts ""

puts "FIELD LENGTHS BY ARRAY: "
set fieldlens [$cur getRowLengths 0]
assertEqual [lindex $fieldlens 0] 1
assertEqual [lindex $fieldlens 1] 1
assertEqual [lindex $fieldlens 2] 1
assertEqual [lindex $fieldlens 3] 4
#assertEqual [lindex $fieldlens 4] 3
#assertEqual [lindex $fieldlens 5] 3
assertEqual [lindex $fieldlens 6] 40
assertEqual [lindex $fieldlens 7] 12
assertEqual [lindex $fieldlens 8] 10
assertEqual [lindex $fieldlens 9] 8
puts ""

puts "INDIVIDUAL SUBSTITUTIONS: "
$cur prepareQuery "values (\$(var1),'\$(var2)','\$(var3)')"
$cur substitution "var1" 1
$cur substitution "var2" "hello"
$cur substitution "var3" 10.5556 6 4
assertTrue [$cur executeQuery]
puts ""

puts "FIELDS: "
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 0 1] "hello"
assertEqual [$cur getFieldByIndex 0 2] "10.5556"
puts ""

puts "ARRAY SUBSTITUTIONS: "
$cur prepareQuery "values (\$(var1),'\$(var2)','\$(var3)')"
$cur substitutions {{"var1" 1} {"var2" "hello"} {"var3" 10.5556 6 4}}
assertTrue [$cur executeQuery]
puts ""

puts "FIELDS: "
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 0 1] "hello"
assertEqual [$cur getFieldByIndex 0 2] "10.5556"
puts ""

puts "RESULT SET BUFFER SIZE: "
assertEqual [$cur getResultSetBufferSize] 0
$cur setResultSetBufferSize 2
assertTrue [$cur sendQuery "select * from testtable order by testsmallint"]
assertEqual [$cur getResultSetBufferSize] 2
puts ""
assertEqual [$cur firstRowIndex] 0
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 2
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 1 0] "2"
assertEqual [$cur getFieldByIndex 2 0] "3"
puts ""
assertEqual [$cur firstRowIndex] 2
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 4
assertEqual [$cur getFieldByIndex 6 0] "7"
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""
assertEqual [$cur firstRowIndex] 6
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 8
assertUndef [$cur getFieldByIndex 8 0]
puts ""
assertEqual [$cur firstRowIndex] 8
assertTrue [$cur endOfResultSet]
assertEqual [$cur rowCount] 8
puts ""

puts "DONT GET COLUMN INFO: "
$cur dontGetColumnInfo 
assertTrue [$cur sendQuery "select * from testtable order by testsmallint"]
assertUndef [$cur getColumnName 0]
assertEqual [$cur getColumnLengthByIndex 0] 0
assertUndef [$cur getColumnTypeByIndex 0]
$cur getColumnInfo 
assertTrue [$cur sendQuery "select * from testtable order by testsmallint"]
assertEqual [$cur getColumnName 0] "TESTSMALLINT"
assertEqual [$cur getColumnLengthByIndex 0] 2
assertEqual [$cur getColumnTypeByIndex 0] "SMALLINT"
puts ""

puts "SUSPENDED SESSION: "
assertTrue [$cur sendQuery "select * from testtable order by testsmallint"]
$cur suspendResultSet 
assertTrue [$con suspendSession]
set port [$con getConnectionPort]
set socket [$con getConnectionSocket]
assertTrue [$con resumeSession $port $socket]
puts ""
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 1 0] "2"
assertEqual [$cur getFieldByIndex 2 0] "3"
assertEqual [$cur getFieldByIndex 3 0] "4"
assertEqual [$cur getFieldByIndex 4 0] "5"
assertEqual [$cur getFieldByIndex 5 0] "6"
assertEqual [$cur getFieldByIndex 6 0] "7"
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""
assertTrue [$cur sendQuery "select * from testtable order by testsmallint"]
$cur suspendResultSet 
assertTrue [$con suspendSession]
set port [$con getConnectionPort]
set socket [$con getConnectionSocket]
assertTrue [$con resumeSession $port $socket]
puts ""
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 1 0] "2"
assertEqual [$cur getFieldByIndex 2 0] "3"
assertEqual [$cur getFieldByIndex 3 0] "4"
assertEqual [$cur getFieldByIndex 4 0] "5"
assertEqual [$cur getFieldByIndex 5 0] "6"
assertEqual [$cur getFieldByIndex 6 0] "7"
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""
assertTrue [$cur sendQuery "select * from testtable order by testsmallint"]
$cur suspendResultSet 
assertTrue [$con suspendSession]
set port [$con getConnectionPort]
set socket [$con getConnectionSocket]
assertTrue [$con resumeSession $port $socket]
puts ""
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 1 0] "2"
assertEqual [$cur getFieldByIndex 2 0] "3"
assertEqual [$cur getFieldByIndex 3 0] "4"
assertEqual [$cur getFieldByIndex 4 0] "5"
assertEqual [$cur getFieldByIndex 5 0] "6"
assertEqual [$cur getFieldByIndex 6 0] "7"
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""

puts "SUSPENDED RESULT SET: "
$cur setResultSetBufferSize 2
assertTrue [$cur sendQuery "select * from testtable order by testsmallint"]
assertEqual [$cur getFieldByIndex 2 0] "3"
set id [$cur getResultSetId]
$cur suspendResultSet 
assertTrue [$con suspendSession]
set port [$con getConnectionPort]
set socket [$con getConnectionSocket]
assertTrue [$con resumeSession $port $socket]
assertTrue [$cur resumeResultSet $id]
puts ""
assertEqual [$cur firstRowIndex] 4
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 6
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""
assertEqual [$cur firstRowIndex] 6
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 8
assertUndef [$cur getFieldByIndex 8 0]
puts ""
assertEqual [$cur firstRowIndex] 8
assertTrue [$cur endOfResultSet]
assertEqual [$cur rowCount] 8
$cur setResultSetBufferSize 0
puts ""

puts "CACHED RESULT SET: "
$cur cacheToFile "cachefile1"
$cur setCacheTtl 200
assertTrue [$cur sendQuery "select * from testtable order by testsmallint"]
set filename [$cur getCacheFileName]
assertEqual $filename "cachefile1"
$cur cacheOff 
assertTrue [$cur openCachedResultSet $filename]
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""

puts "COLUMN COUNT FOR CACHED RESULT SET: "
assertEqual [$cur colCount] 11
puts ""

puts "COLUMN NAMES FOR CACHED RESULT SET: "
assertEqual [$cur getColumnName 0] "TESTSMALLINT"
assertEqual [$cur getColumnName 1] "TESTINT"
assertEqual [$cur getColumnName 2] "TESTBIGINT"
assertEqual [$cur getColumnName 3] "TESTDECIMAL"
assertEqual [$cur getColumnName 4] "TESTREAL"
assertEqual [$cur getColumnName 5] "TESTDOUBLE"
assertEqual [$cur getColumnName 6] "TESTCHAR"
assertEqual [$cur getColumnName 7] "TESTVARCHAR"
assertEqual [$cur getColumnName 8] "TESTDATE"
assertEqual [$cur getColumnName 9] "TESTTIME"
assertEqual [$cur getColumnName 10] "TESTTIMESTAMP"
set cols [$cur getColumnNames]
assertEqual [lindex $cols 0] "TESTSMALLINT"
assertEqual [lindex $cols 1] "TESTINT"
assertEqual [lindex $cols 2] "TESTBIGINT"
assertEqual [lindex $cols 3] "TESTDECIMAL"
assertEqual [lindex $cols 4] "TESTREAL"
assertEqual [lindex $cols 5] "TESTDOUBLE"
assertEqual [lindex $cols 6] "TESTCHAR"
assertEqual [lindex $cols 7] "TESTVARCHAR"
assertEqual [lindex $cols 8] "TESTDATE"
assertEqual [lindex $cols 9] "TESTTIME"
assertEqual [lindex $cols 10] "TESTTIMESTAMP"
puts ""

puts "CACHED RESULT SET WITH RESULT SET BUFFER SIZE: "
$cur setResultSetBufferSize 2
$cur cacheToFile "cachefile1"
$cur setCacheTtl 200
assertTrue [$cur sendQuery "select * from testtable order by testsmallint"]
set filename [$cur getCacheFileName]
assertEqual $filename "cachefile1"
$cur cacheOff 
assertTrue [$cur openCachedResultSet $filename]
assertEqual [$cur getFieldByIndex 7 0] "8"
assertUndef [$cur getFieldByIndex 8 0]
$cur setResultSetBufferSize 0
puts ""

puts "FROM ONE CACHE FILE TO ANOTHER: "
$cur cacheToFile "cachefile2"
assertTrue [$cur openCachedResultSet "cachefile1"]
$cur cacheOff 
assertTrue [$cur openCachedResultSet "cachefile2"]
assertEqual [$cur getFieldByIndex 7 0] "8"
assertUndef [$cur getFieldByIndex 8 0]
puts ""

puts "FROM ONE CACHE FILE TO ANOTHER WITH RESULT SET BUFFER SIZE: "
$cur setResultSetBufferSize 2
$cur cacheToFile "cachefile2"
assertTrue [$cur openCachedResultSet "cachefile1"]
$cur cacheOff 
assertTrue [$cur openCachedResultSet "cachefile2"]
assertEqual [$cur getFieldByIndex 7 0] "8"
assertUndef [$cur getFieldByIndex 8 0]
$cur setResultSetBufferSize 0
puts ""

puts "CACHED RESULT SET WITH SUSPEND AND RESULT SET BUFFER SIZE: "
$cur setResultSetBufferSize 2
$cur cacheToFile "cachefile1"
$cur setCacheTtl 200
assertTrue [$cur sendQuery "select * from testtable order by testsmallint"]
assertEqual [$cur getFieldByIndex 2 0] "3"
set filename [$cur getCacheFileName]
assertEqual $filename "cachefile1"
set id [$cur getResultSetId]
$cur suspendResultSet 
assertTrue [$con suspendSession]
set port [$con getConnectionPort]
set socket [$con getConnectionSocket]
puts ""
assertTrue [$con resumeSession $port $socket]
assertTrue [$cur resumeCachedResultSet $id $filename]
puts ""
assertEqual [$cur firstRowIndex] 4
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 6
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""
assertEqual [$cur firstRowIndex] 6
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 8
assertUndef [$cur getFieldByIndex 8 0]
puts ""
assertEqual [$cur firstRowIndex] 8
assertTrue [$cur endOfResultSet]
assertEqual [$cur rowCount] 8
$cur cacheOff 
puts ""
assertTrue [$cur openCachedResultSet $filename]
assertEqual [$cur getFieldByIndex 7 0] "8"
assertUndef [$cur getFieldByIndex 8 0]
$cur setResultSetBufferSize 0
puts ""

puts "FINISHED SUSPENDED SESSION: "
assertTrue [$cur sendQuery "select * from testtable order by testint"]
assertEqual [$cur getFieldByIndex 4 0] "5"
assertEqual [$cur getFieldByIndex 5 0] "6"
assertEqual [$cur getFieldByIndex 6 0] "7"
assertEqual [$cur getFieldByIndex 7 0] "8"
set id [$cur getResultSetId]
$cur suspendResultSet 
assertTrue [$con suspendSession]
set port [$con getConnectionPort]
set socket [$con getConnectionSocket]
assertTrue [$con resumeSession $port $socket]
assertTrue [$cur resumeResultSet $id]
assertUndef [$cur getFieldByIndex 4 0]
assertUndef [$cur getFieldByIndex 5 0]
assertUndef [$cur getFieldByIndex 6 0]
assertUndef [$cur getFieldByIndex 7 0]
puts ""

# drop existing table
$con commit 
catch {$cur sendQuery "drop table testtable"}
puts ""

# invalid queries...
puts "INVALID QUERIES: "
catch {assertFalse [$cur sendQuery "select * from testtable order by testsmallint"]}
catch {assertFalse [$cur sendQuery "select * from testtable order by testsmallint"]}
catch {assertFalse [$cur sendQuery "select * from testtable order by testsmallint"]}
catch {assertFalse [$cur sendQuery "select * from testtable order by testsmallint"]}
puts ""
catch {assertFalse [$cur sendQuery "insert into testtable values (1,2,3,4)"]}
catch {assertFalse [$cur sendQuery "insert into testtable values (1,2,3,4)"]}
catch {assertFalse [$cur sendQuery "insert into testtable values (1,2,3,4)"]}
catch {assertFalse [$cur sendQuery "insert into testtable values (1,2,3,4)"]}
