# encoded binary data
puts "ENCODED BINARY DATA: "
catch {$cur sendQuery "drop table testtable"}
assertTrue [$cur sendQuery "create table testtable (col1 bytea)"]
set buffer ""
for {set j 0} {$j<256} {incr j} {
	append buffer [binary format c $j]
}
set querystr "insert into testtable values (decode('[binary encode hex $buffer]','hex'))"
assertTrue [$cur sendQuery $querystr]
assertTrue [$cur sendQuery "select col1 from testtable"]
assertEqual [$cur getFieldLengthByIndex 0 0] 256
assertEqual [$cur getFieldByIndex 0 0] $buffer
assertTrue [$cur sendQuery "drop table testtable"]
puts ""


