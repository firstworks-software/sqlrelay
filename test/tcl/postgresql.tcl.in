load @TCLLIBSPATH@@SLASH@sqlrelay@SLASH@sqlrelay.@SOSUFFIX@ sqlrelay
source ./assert.tcl


# instantiation
set con [sqlrcon -server "sqlrelay" -port 9000 -socket "/tmp/test.socket" -user "testuser" -password "testpassword" -retrytime 0 -tries 1]
set cur [$con sqlrcur]

puts "IDENTIFY: "
assertEqual [$con identify] "postgresql"
puts ""

# ping
puts "PING: "
assertTrue [$con ping]
puts ""

# isolation levels
#puts "ISOLATION LEVELS: "
#set isolationlevels [list "read committed" "read uncommitted" "repeatable read" "serializable"]
#foreach il $isolationlevels {
#	# postgresql requires the isolation level to
#	# be the first query of the transaction
#	$con begin
#	assertTrue [$con setIsolationLevel $il]
#	assertEqual [$con getIsolationLevel] $il
#	$con commit
#	puts ""
#}
## reset to the default isolation level
#$con begin
#assertTrue [$con setIsolationLevel [lindex $isolationlevels 0]]
#$con commit
#puts ""

# drop existing table
catch {$cur sendQuery "drop table testtable"}

puts "CREATE TEMPTABLE: "
assertTrue [$cur sendQuery "create table testtable (testint int, testfloat float, testreal real, testsmallint smallint, testchar char(40), testvarchar varchar(40), testdate date, testtime time, testtimestamp timestamp)"]
puts ""

puts "BEGIN TRANSCTION: "
assertTrue [$cur sendQuery "begin"]
puts ""

puts "INSERT: "
assertTrue [$cur sendQuery "insert into testtable values (1,1.1,1.1,1,'testchar1','testvarchar1','01/01/2001','01:00:00',NULL)"]
assertTrue [$cur sendQuery "insert into testtable values (2,2.2,2.2,2,'testchar2','testvarchar2','01/01/2002','02:00:00',NULL)"]
assertTrue [$cur sendQuery "insert into testtable values (3,3.3,3.3,3,'testchar3','testvarchar3','01/01/2003','03:00:00',NULL)"]
assertTrue [$cur sendQuery "insert into testtable values (4,4.4,4.4,4,'testchar4','testvarchar4','01/01/2004','04:00:00',NULL)"]
puts ""

puts "AFFECTED ROWS: "
assertEqual [$cur affectedRows] 1
puts ""

puts "BIND BY POSITION: "
$cur prepareQuery "insert into testtable values (\$1,\$2,\$3,\$4,\$5,\$6,\$7,\$8)"
assertEqual [$cur countBindVariables] 8
$cur inputBind "1" 5
$cur inputBind "2" 5.5 4 2
$cur inputBind "3" 5.5 4 2
$cur inputBind "4" 5
$cur inputBind "5" "testchar5"
$cur inputBind "6" "testvarchar5"
$cur inputBind "7" "01/01/2005"
$cur inputBind "8" "05:00:00"
assertTrue [$cur executeQuery]
$cur clearBinds 
$cur inputBind "1" 6
$cur inputBind "2" 6.6 4 2
$cur inputBind "3" 6.6 4 2
$cur inputBind "4" 6
$cur inputBind "5" "testchar6"
$cur inputBind "6" "testvarchar6"
$cur inputBind "7" "01/01/2006"
$cur inputBind "8" "06:00:00"
assertTrue [$cur executeQuery]
puts ""

puts "ARRAY OF BINDS BY POSITION: "
$cur clearBinds
$cur inputBinds {{"1" 7} {"2" 7.7 4 2} {"3" 7.7 4 2} {"4" 7} {"5" "testchar7"} {"6" "testchar7"} {"7" "01/01/2007"} {"8" "07:00:00"}}
assertTrue [$cur executeQuery]
puts ""

puts "BIND BY POSITION WITH VALIDATION: "
$cur clearBinds 
$cur inputBind "1" 8
$cur inputBind "2" 8.8 4 2
$cur inputBind "3" 8.8 4 2
$cur inputBind "4" 8
$cur inputBind "5" "testchar8"
$cur inputBind "6" "testvarchar8"
$cur inputBind "7" "01/01/2008"
$cur inputBind "8" "08:00:00"
$cur validateBinds 
assertTrue [$cur executeQuery]
puts ""

puts "SELECT: "
assertTrue [$cur sendQuery "select * from testtable order by testint"]
puts ""

puts "COLUMN COUNT: "
assertEqual [$cur colCount] 9
puts ""

puts "COLUMN NAMES: "
assertEqual [$cur getColumnName 0] "testint"
assertEqual [$cur getColumnName 1] "testfloat"
assertEqual [$cur getColumnName 2] "testreal"
assertEqual [$cur getColumnName 3] "testsmallint"
assertEqual [$cur getColumnName 4] "testchar"
assertEqual [$cur getColumnName 5] "testvarchar"
assertEqual [$cur getColumnName 6] "testdate"
assertEqual [$cur getColumnName 7] "testtime"
assertEqual [$cur getColumnName 8] "testtimestamp"
set cols [$cur getColumnNames]
assertEqual [lindex $cols 0] "testint"
assertEqual [lindex $cols 1] "testfloat"
assertEqual [lindex $cols 2] "testreal"
assertEqual [lindex $cols 3] "testsmallint"
assertEqual [lindex $cols 4] "testchar"
assertEqual [lindex $cols 5] "testvarchar"
assertEqual [lindex $cols 6] "testdate"
assertEqual [lindex $cols 7] "testtime"
assertEqual [lindex $cols 8] "testtimestamp"
puts ""

puts "COLUMN TYPES: "
assertEqual [$cur getColumnTypeByIndex 0] "int4"
assertEqual [$cur getColumnTypeByName "testint"] "int4"
assertEqual [$cur getColumnTypeByIndex 1] "float8"
assertEqual [$cur getColumnTypeByName "testfloat"] "float8"
assertEqual [$cur getColumnTypeByIndex 2] "float4"
assertEqual [$cur getColumnTypeByName "testreal"] "float4"
assertEqual [$cur getColumnTypeByIndex 3] "int2"
assertEqual [$cur getColumnTypeByName "testsmallint"] "int2"
assertEqual [$cur getColumnTypeByIndex 4] "bpchar"
assertEqual [$cur getColumnTypeByName "testchar"] "bpchar"
assertEqual [$cur getColumnTypeByIndex 5] "varchar"
assertEqual [$cur getColumnTypeByName "testvarchar"] "varchar"
assertEqual [$cur getColumnTypeByIndex 6] "date"
assertEqual [$cur getColumnTypeByName "testdate"] "date"
assertEqual [$cur getColumnTypeByIndex 7] "time"
assertEqual [$cur getColumnTypeByName "testtime"] "time"
assertEqual [$cur getColumnTypeByIndex 8] "timestamp"
assertEqual [$cur getColumnTypeByName "testtimestamp"] "timestamp"
puts ""

puts "COLUMN LENGTH: "
assertEqual [$cur getColumnLengthByIndex 0] 4
assertEqual [$cur getColumnLengthByName "testint"] 4
assertEqual [$cur getColumnLengthByIndex 1] 8
assertEqual [$cur getColumnLengthByName "testfloat"] 8
assertEqual [$cur getColumnLengthByIndex 2] 4
assertEqual [$cur getColumnLengthByName "testreal"] 4
assertEqual [$cur getColumnLengthByIndex 3] 2
assertEqual [$cur getColumnLengthByName "testsmallint"] 2
assertEqual [$cur getColumnLengthByIndex 4] 44
assertEqual [$cur getColumnLengthByName "testchar"] 44
assertEqual [$cur getColumnLengthByIndex 5] 44
assertEqual [$cur getColumnLengthByName "testvarchar"] 44
assertEqual [$cur getColumnLengthByIndex 6] 4
assertEqual [$cur getColumnLengthByName "testdate"] 4
assertEqual [$cur getColumnLengthByIndex 7] 8
assertEqual [$cur getColumnLengthByName "testtime"] 8
assertEqual [$cur getColumnLengthByIndex 8] 8
assertEqual [$cur getColumnLengthByName "testtimestamp"] 8
puts ""

puts "LONGEST COLUMN: "
assertEqual [$cur getLongestByIndex 0] 1
assertEqual [$cur getLongestByName "testint"] 1
assertEqual [$cur getLongestByIndex 1] 3
assertEqual [$cur getLongestByName "testfloat"] 3
assertEqual [$cur getLongestByIndex 2] 3
assertEqual [$cur getLongestByName "testreal"] 3
assertEqual [$cur getLongestByIndex 3] 1
assertEqual [$cur getLongestByName "testsmallint"] 1
assertEqual [$cur getLongestByIndex 4] 40
assertEqual [$cur getLongestByName "testchar"] 40
assertEqual [$cur getLongestByIndex 5] 12
assertEqual [$cur getLongestByName "testvarchar"] 12
assertEqual [$cur getLongestByIndex 6] 10
assertEqual [$cur getLongestByName "testdate"] 10
assertEqual [$cur getLongestByIndex 7] 8
assertEqual [$cur getLongestByName "testtime"] 8
puts ""

puts "ROW COUNT: "
assertEqual [$cur rowCount] 8
puts ""

#puts "TOTAL ROWS: "
#assertEqual [$cur totalRows] 8
#puts ""

puts "FIRST ROW INDEX: "
assertEqual [$cur firstRowIndex] 0
puts ""

puts "END OF RESULT SET: "
assertTrue [$cur endOfResultSet]
puts ""

puts "FIELDS BY INDEX: "
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 0 1] "1.1"
assertEqual [$cur getFieldByIndex 0 2] "1.1"
assertEqual [$cur getFieldByIndex 0 3] "1"
assertEqual [$cur getFieldByIndex 0 4] "testchar1                               "
assertEqual [$cur getFieldByIndex 0 5] "testvarchar1"
assertEqual [$cur getFieldByIndex 0 6] "2001-01-01"
assertEqual [$cur getFieldByIndex 0 7] "01:00:00"
puts ""
assertEqual [$cur getFieldByIndex 7 0] "8"
assertEqual [$cur getFieldByIndex 7 1] "8.8"
assertEqual [$cur getFieldByIndex 7 2] "8.8"
assertEqual [$cur getFieldByIndex 7 3] "8"
assertEqual [$cur getFieldByIndex 7 4] "testchar8                               "
assertEqual [$cur getFieldByIndex 7 5] "testvarchar8"
assertEqual [$cur getFieldByIndex 7 6] "2008-01-01"
assertEqual [$cur getFieldByIndex 7 7] "08:00:00"
puts ""

puts "FIELD LENGTHS BY INDEX: "
assertEqual [$cur getFieldLengthByIndex 0 0] 1
assertEqual [$cur getFieldLengthByIndex 0 1] 3
assertEqual [$cur getFieldLengthByIndex 0 2] 3
assertEqual [$cur getFieldLengthByIndex 0 3] 1
assertEqual [$cur getFieldLengthByIndex 0 4] 40
assertEqual [$cur getFieldLengthByIndex 0 5] 12
assertEqual [$cur getFieldLengthByIndex 0 6] 10
assertEqual [$cur getFieldLengthByIndex 0 7] 8
puts ""
assertEqual [$cur getFieldLengthByIndex 7 0] 1
assertEqual [$cur getFieldLengthByIndex 7 1] 3
assertEqual [$cur getFieldLengthByIndex 7 2] 3
assertEqual [$cur getFieldLengthByIndex 7 3] 1
assertEqual [$cur getFieldLengthByIndex 7 4] 40
assertEqual [$cur getFieldLengthByIndex 7 5] 12
assertEqual [$cur getFieldLengthByIndex 7 6] 10
assertEqual [$cur getFieldLengthByIndex 7 7] 8
puts ""

puts "FIELDS BY NAME: "
assertEqual [$cur getFieldByName 0 "testint"] "1"
assertEqual [$cur getFieldByName 0 "testfloat"] "1.1"
assertEqual [$cur getFieldByName 0 "testreal"] "1.1"
assertEqual [$cur getFieldByName 0 "testsmallint"] "1"
assertEqual [$cur getFieldByName 0 "testchar"] "testchar1                               "
assertEqual [$cur getFieldByName 0 "testvarchar"] "testvarchar1"
assertEqual [$cur getFieldByName 0 "testdate"] "2001-01-01"
assertEqual [$cur getFieldByName 0 "testtime"] "01:00:00"
puts ""
assertEqual [$cur getFieldByName 7 "testint"] "8"
assertEqual [$cur getFieldByName 7 "testfloat"] "8.8"
assertEqual [$cur getFieldByName 7 "testreal"] "8.8"
assertEqual [$cur getFieldByName 7 "testsmallint"] "8"
assertEqual [$cur getFieldByName 7 "testchar"] "testchar8                               "
assertEqual [$cur getFieldByName 7 "testvarchar"] "testvarchar8"
assertEqual [$cur getFieldByName 7 "testdate"] "2008-01-01"
assertEqual [$cur getFieldByName 7 "testtime"] "08:00:00"
puts ""

puts "FIELD LENGTHS BY NAME: "
assertEqual [$cur getFieldLengthByName 0 "testint"] 1
assertEqual [$cur getFieldLengthByName 0 "testfloat"] 3
assertEqual [$cur getFieldLengthByName 0 "testreal"] 3
assertEqual [$cur getFieldLengthByName 0 "testsmallint"] 1
assertEqual [$cur getFieldLengthByName 0 "testchar"] 40
assertEqual [$cur getFieldLengthByName 0 "testvarchar"] 12
assertEqual [$cur getFieldLengthByName 0 "testdate"] 10
assertEqual [$cur getFieldLengthByName 0 "testtime"] 8
puts ""
assertEqual [$cur getFieldLengthByName 7 "testint"] 1
assertEqual [$cur getFieldLengthByName 7 "testfloat"] 3
assertEqual [$cur getFieldLengthByName 7 "testreal"] 3
assertEqual [$cur getFieldLengthByName 7 "testsmallint"] 1
assertEqual [$cur getFieldLengthByName 7 "testchar"] 40
assertEqual [$cur getFieldLengthByName 7 "testvarchar"] 12
assertEqual [$cur getFieldLengthByName 7 "testdate"] 10
assertEqual [$cur getFieldLengthByName 7 "testtime"] 8
puts ""

puts "FIELDS BY ARRAY: "
set fields [$cur getRow 0]
assertEqual [lindex $fields 0] 1
assertEqual [lindex $fields 1] 1.1
assertEqual [lindex $fields 2] 1.1
assertEqual [lindex $fields 3] 1
assertEqual [lindex $fields 4] "testchar1                               "
assertEqual [lindex $fields 5] "testvarchar1"
assertEqual [lindex $fields 6] "2001-01-01"
assertEqual [lindex $fields 7] "01:00:00"
puts ""

puts "FIELD LENGTHS BY ARRAY: "
set fieldlens [$cur getRowLengths 0]
assertEqual [lindex $fieldlens 0] 1
assertEqual [lindex $fieldlens 1] 3
assertEqual [lindex $fieldlens 2] 3
assertEqual [lindex $fieldlens 3] 1
assertEqual [lindex $fieldlens 4] 40
assertEqual [lindex $fieldlens 5] 12
assertEqual [lindex $fieldlens 6] 10
assertEqual [lindex $fieldlens 7] 8
puts ""

puts "INDIVIDUAL SUBSTITUTIONS: "
$cur prepareQuery "select \$(var1),'\$(var2)',\$(var3)"
$cur substitution "var1" 1
$cur substitution "var2" "hello"
$cur substitution "var3" 10.5556 6 4
assertTrue [$cur executeQuery]
puts ""

puts "FIELDS: "
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 0 1] "hello"
assertEqual [$cur getFieldByIndex 0 2] "10.5556"
puts ""

puts "ARRAY SUBSTITUTIONS: "
$cur prepareQuery "select \$(var1),'\$(var2)',\$(var3)"
$cur substitutions {{"var1" 1} {"var2" "hello"} {"var3" 10.5556 6 4}}
assertTrue [$cur executeQuery]
puts ""

puts "FIELDS: "
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 0 1] "hello"
assertEqual [$cur getFieldByIndex 0 2] "10.5556"
puts ""

puts "RESULT SET BUFFER SIZE: "
assertEqual [$cur getResultSetBufferSize] 0
$cur setResultSetBufferSize 2
assertTrue [$cur sendQuery "select * from testtable order by testint"]
assertEqual [$cur getResultSetBufferSize] 2
puts ""
assertEqual [$cur firstRowIndex] 0
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 2
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 1 0] "2"
assertEqual [$cur getFieldByIndex 2 0] "3"
puts ""
assertEqual [$cur firstRowIndex] 2
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 4
assertEqual [$cur getFieldByIndex 6 0] "7"
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""
assertEqual [$cur firstRowIndex] 6
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 8
assertUndef [$cur getFieldByIndex 8 0]
puts ""
assertEqual [$cur firstRowIndex] 8
assertTrue [$cur endOfResultSet]
assertEqual [$cur rowCount] 8
puts ""

puts "DONT GET COLUMN INFO: "
$cur dontGetColumnInfo 
assertTrue [$cur sendQuery "select * from testtable order by testint"]
assertUndef [$cur getColumnName 0]
assertEqual [$cur getColumnLengthByIndex 0] 0
assertUndef [$cur getColumnTypeByIndex 0]
$cur getColumnInfo 
assertTrue [$cur sendQuery "select * from testtable order by testint"]
assertEqual [$cur getColumnName 0] "testint"
assertEqual [$cur getColumnLengthByIndex 0] 4
assertEqual [$cur getColumnTypeByIndex 0] "int4"
puts ""

puts "SUSPENDED SESSION: "
assertTrue [$cur sendQuery "select * from testtable order by testint"]
$cur suspendResultSet 
assertTrue [$con suspendSession]
set port [$con getConnectionPort]
set socket [$con getConnectionSocket]
assertTrue [$con resumeSession $port $socket]
puts ""
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 1 0] "2"
assertEqual [$cur getFieldByIndex 2 0] "3"
assertEqual [$cur getFieldByIndex 3 0] "4"
assertEqual [$cur getFieldByIndex 4 0] "5"
assertEqual [$cur getFieldByIndex 5 0] "6"
assertEqual [$cur getFieldByIndex 6 0] "7"
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""
assertTrue [$cur sendQuery "select * from testtable order by testint"]
$cur suspendResultSet 
assertTrue [$con suspendSession]
set port [$con getConnectionPort]
set socket [$con getConnectionSocket]
assertTrue [$con resumeSession $port $socket]
puts ""
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 1 0] "2"
assertEqual [$cur getFieldByIndex 2 0] "3"
assertEqual [$cur getFieldByIndex 3 0] "4"
assertEqual [$cur getFieldByIndex 4 0] "5"
assertEqual [$cur getFieldByIndex 5 0] "6"
assertEqual [$cur getFieldByIndex 6 0] "7"
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""
assertTrue [$cur sendQuery "select * from testtable order by testint"]
$cur suspendResultSet 
assertTrue [$con suspendSession]
set port [$con getConnectionPort]
set socket [$con getConnectionSocket]
assertTrue [$con resumeSession $port $socket]
puts ""
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 1 0] "2"
assertEqual [$cur getFieldByIndex 2 0] "3"
assertEqual [$cur getFieldByIndex 3 0] "4"
assertEqual [$cur getFieldByIndex 4 0] "5"
assertEqual [$cur getFieldByIndex 5 0] "6"
assertEqual [$cur getFieldByIndex 6 0] "7"
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""

puts "SUSPENDED RESULT SET: "
$cur setResultSetBufferSize 2
assertTrue [$cur sendQuery "select * from testtable order by testint"]
assertEqual [$cur getFieldByIndex 2 0] "3"
set id [$cur getResultSetId]
$cur suspendResultSet 
assertTrue [$con suspendSession]
set port [$con getConnectionPort]
set socket [$con getConnectionSocket]
assertTrue [$con resumeSession $port $socket]
assertTrue [$cur resumeResultSet $id]
puts ""
assertEqual [$cur firstRowIndex] 4
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 6
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""
assertEqual [$cur firstRowIndex] 6
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 8
assertUndef [$cur getFieldByIndex 8 0]
puts ""
assertEqual [$cur firstRowIndex] 8
assertTrue [$cur endOfResultSet]
assertEqual [$cur rowCount] 8
$cur setResultSetBufferSize 0
puts ""

puts "CACHED RESULT SET: "
$cur cacheToFile "cachefile1"
$cur setCacheTtl 200
assertTrue [$cur sendQuery "select * from testtable order by testint"]
set filename [$cur getCacheFileName]
assertEqual $filename "cachefile1"
$cur cacheOff 
assertTrue [$cur openCachedResultSet $filename]
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""

puts "COLUMN COUNT FOR CACHED RESULT SET: "
assertEqual [$cur colCount] 9
puts ""

puts "COLUMN NAMES FOR CACHED RESULT SET: "
assertEqual [$cur getColumnName 0] "testint"
assertEqual [$cur getColumnName 1] "testfloat"
assertEqual [$cur getColumnName 2] "testreal"
assertEqual [$cur getColumnName 3] "testsmallint"
assertEqual [$cur getColumnName 4] "testchar"
assertEqual [$cur getColumnName 5] "testvarchar"
assertEqual [$cur getColumnName 6] "testdate"
assertEqual [$cur getColumnName 7] "testtime"
assertEqual [$cur getColumnName 8] "testtimestamp"
set cols [$cur getColumnNames]
assertEqual [lindex $cols 0] "testint"
assertEqual [lindex $cols 1] "testfloat"
assertEqual [lindex $cols 2] "testreal"
assertEqual [lindex $cols 3] "testsmallint"
assertEqual [lindex $cols 4] "testchar"
assertEqual [lindex $cols 5] "testvarchar"
assertEqual [lindex $cols 6] "testdate"
assertEqual [lindex $cols 7] "testtime"
assertEqual [lindex $cols 8] "testtimestamp"
puts ""

puts "CACHED RESULT SET WITH RESULT SET BUFFER SIZE: "
$cur setResultSetBufferSize 2
$cur cacheToFile "cachefile1"
$cur setCacheTtl 200
assertTrue [$cur sendQuery "select * from testtable order by testint"]
set filename [$cur getCacheFileName]
assertEqual $filename "cachefile1"
$cur cacheOff 
assertTrue [$cur openCachedResultSet $filename]
assertEqual [$cur getFieldByIndex 7 0] "8"
assertUndef [$cur getFieldByIndex 8 0]
$cur setResultSetBufferSize 0
puts ""

puts "FROM ONE CACHE FILE TO ANOTHER: "
$cur cacheToFile "cachefile2"
assertTrue [$cur openCachedResultSet "cachefile1"]
$cur cacheOff 
assertTrue [$cur openCachedResultSet "cachefile2"]
assertEqual [$cur getFieldByIndex 7 0] "8"
assertUndef [$cur getFieldByIndex 8 0]
puts ""

puts "FROM ONE CACHE FILE TO ANOTHER WITH RESULT SET BUFFER SIZE: "
$cur setResultSetBufferSize 2
$cur cacheToFile "cachefile2"
assertTrue [$cur openCachedResultSet "cachefile1"]
$cur cacheOff 
assertTrue [$cur openCachedResultSet "cachefile2"]
assertEqual [$cur getFieldByIndex 7 0] "8"
assertUndef [$cur getFieldByIndex 8 0]
$cur setResultSetBufferSize 0
puts ""

puts "CACHED RESULT SET WITH SUSPEND AND RESULT SET BUFFER SIZE: "
$cur setResultSetBufferSize 2
$cur cacheToFile "cachefile1"
$cur setCacheTtl 200
assertTrue [$cur sendQuery "select * from testtable order by testint"]
assertEqual [$cur getFieldByIndex 2 0] "3"
set filename [$cur getCacheFileName]
assertEqual $filename "cachefile1"
set id [$cur getResultSetId]
$cur suspendResultSet 
assertTrue [$con suspendSession]
set port [$con getConnectionPort]
set socket [$con getConnectionSocket]
puts ""
assertTrue [$con resumeSession $port $socket]
assertTrue [$cur resumeCachedResultSet $id $filename]
puts ""
assertEqual [$cur firstRowIndex] 4
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 6
assertEqual [$cur getFieldByIndex 7 0] "8"
puts ""
assertEqual [$cur firstRowIndex] 6
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 8
assertUndef [$cur getFieldByIndex 8 0]
puts ""
assertEqual [$cur firstRowIndex] 8
assertTrue [$cur endOfResultSet]
assertEqual [$cur rowCount] 8
$cur cacheOff 
puts ""
assertTrue [$cur openCachedResultSet $filename]
assertEqual [$cur getFieldByIndex 7 0] "8"
assertUndef [$cur getFieldByIndex 8 0]
$cur setResultSetBufferSize 0
puts ""

puts "COMMIT AND ROLLBACK: "
set secondcon [sqlrcon -server "sqlrelay" -port 9000 -socket "/tmp/test.socket" -user "testuser" -password "testpassword" -retrytime 0 -tries 1]
set secondcur [$secondcon sqlrcur]

assertTrue [$secondcur sendQuery "select count(*) from testtable"]
assertEqual [$secondcur getFieldByIndex 0 0] "0"
assertTrue [$con commit]
assertTrue [$secondcur sendQuery "select count(*) from testtable"]
assertEqual [$secondcur getFieldByIndex 0 0] "8"
#assertEqual [$con autoCommitOn] 1
assertTrue [$cur sendQuery "insert into testtable values (10,10.1,10.1,10,'testchar10','testvarchar10','01/01/2010','10:00:00',NULL)"]
assertTrue [$secondcur sendQuery "select count(*) from testtable"]
assertEqual [$secondcur getFieldByIndex 0 0] "9"
#assertEqual [$con autoCommitOff] 1
puts ""

puts "FINISHED SUSPENDED SESSION: "
assertTrue [$cur sendQuery "select * from testtable order by testint"]
assertEqual [$cur getFieldByIndex 4 0] "5"
assertEqual [$cur getFieldByIndex 5 0] "6"
assertEqual [$cur getFieldByIndex 6 0] "7"
assertEqual [$cur getFieldByIndex 7 0] "8"
set id [$cur getResultSetId]
$cur suspendResultSet 
assertTrue [$con suspendSession]
set port [$con getConnectionPort]
set socket [$con getConnectionSocket]
assertTrue [$con resumeSession $port $socket]
assertTrue [$cur resumeResultSet $id]
assertUndef [$cur getFieldByIndex 4 0]
assertUndef [$cur getFieldByIndex 5 0]
assertUndef [$cur getFieldByIndex 6 0]
assertUndef [$cur getFieldByIndex 7 0]
puts ""

puts "STORED PROCEDURES: "
catch {$cur sendQuery "drop function testfunc(int)"}
assertTrue [$cur sendQuery "create function testfunc(int) returns int as ' begin return \$1; end;' language plpgsql"]
$cur prepareQuery "select * from testfunc(\$1)"
$cur inputBind "1" 5
assertTrue [$cur executeQuery]
assertEqual [$cur getFieldByIndex 0 0] "5"
catch {$cur sendQuery "drop function testfunc(int)"}

catch {$cur sendQuery "drop function testfunc(int,char(20))"}
assertTrue [$cur sendQuery "create function testfunc(int, char(20)) returns record as ' declare output record; begin select \$1,\$2 into output; return output; end;' language plpgsql"]
$cur prepareQuery "select * from testfunc(\$1,\$2) as (col1 int, col2 bpchar)"
$cur inputBind "1" 5
$cur inputBind "2" "hello"
assertTrue [$cur executeQuery]
assertEqual [$cur getFieldByIndex 0 0] "5"
assertEqual [$cur getFieldByIndex 0 1] "hello"
catch {$cur sendQuery "drop function testfunc(int,char(20))"}
puts ""

# drop existing table
catch {$cur sendQuery "drop table testtable"}

# invalid queries...
puts "INVALID QUERIES: "
catch {assertFalse [$cur sendQuery "select * from testtable order by testint"]}
catch {assertFalse [$cur sendQuery "select * from testtable order by testint"]}
catch {assertFalse [$cur sendQuery "select * from testtable order by testint"]}
catch {assertFalse [$cur sendQuery "select * from testtable order by testint"]}
puts ""
catch {assertFalse [$cur sendQuery "insert into testtable values (1,2,3,4)"]}
catch {assertFalse [$cur sendQuery "insert into testtable values (1,2,3,4)"]}
catch {assertFalse [$cur sendQuery "insert into testtable values (1,2,3,4)"]}
catch {assertFalse [$cur sendQuery "insert into testtable values (1,2,3,4)"]}
puts ""
catch {assertFalse [$cur sendQuery "create table testtable"]}
catch {assertFalse [$cur sendQuery "create table testtable"]}
catch {assertFalse [$cur sendQuery "create table testtable"]}
catch {assertFalse [$cur sendQuery "create table testtable"]}
puts ""

exit 0
