# long lobs
puts "LONG LOBS: "
catch {$cur sendQuery "drop table testtable"}
$cur sendQuery "create table testtable (testclob clob, testblob blob)"
$cur prepareQuery "insert into testtable values (:clobval,:blobval)"
set largebufferlist {}
for {set i 0} {$i<8192} {incr i} {
	lappend largebufferlist "C"
}
