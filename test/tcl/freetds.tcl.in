# table type list
puts "TABLE TYPE LIST: "
assertTrue [$cur getTableTypeList]
assertEqual [$cur getColumnName 0] "table_type"
set found 0
for {set i 0} {$i < [$cur rowCount]} {incr i} {
	if {[$cur getFieldByName $i "table_type"] eq "TABLE"} {
		set found 1
		break
	}
}
assertTrue $found
