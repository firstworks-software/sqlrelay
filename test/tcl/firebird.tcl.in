assertEqual [lindex $cols 0] "TESTINTEGER"
assertEqual [lindex $cols 1] "TESTSMALLINT"
assertEqual [lindex $cols 2] "TESTDECIMAL"
assertEqual [lindex $cols 3] "TESTNUMERIC"
assertEqual [lindex $cols 4] "TESTFLOAT"
assertEqual [lindex $cols 5] "TESTDOUBLE"
assertEqual [lindex $cols 6] "TESTDATE"
assertEqual [lindex $cols 7] "TESTTIME"
assertEqual [lindex $cols 8] "TESTCHAR"
assertEqual [lindex $cols 9] "TESTVARCHAR"
assertEqual [lindex $cols 10] "TESTTIMESTAMP"
assertEqual [lindex $cols 11] "TESTBLOB"
puts ""


# column types
puts "COLUMN TYPES: "
assertEqual [$cur getColumnTypeByIndex 0] "INTEGER"
assertEqual [$cur getColumnTypeByName "TESTINTEGER"] "INTEGER"
assertEqual [$cur getColumnTypeByIndex 1] "SMALLINT"
assertEqual [$cur getColumnTypeByName "TESTSMALLINT"] "SMALLINT"
assertEqual [$cur getColumnTypeByIndex 2] "DECIMAL"
