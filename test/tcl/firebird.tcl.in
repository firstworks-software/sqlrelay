# column length
puts "COLUMN LENGTH: "
assertEqual [$cur getColumnLengthByIndex 0] 4
assertEqual [$cur getColumnLengthByName "TESTINTEGER"] 4
assertEqual [$cur getColumnLengthByIndex 1] 2
