assertEqual [$cur firstRowIndex] 0
assertFalse [$cur endOfResultSet]
assertEqual [$cur rowCount] 2
assertEqual [$cur getFieldByIndex 0 0] "1"
assertEqual [$cur getFieldByIndex 1 0] "2"
