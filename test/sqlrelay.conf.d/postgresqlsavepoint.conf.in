<?xml version="1.0"?>
<instances>

	<instance id="postgresqlsavepoint" dbase="postgresql">
		<listeners>
			<listener port="9021" socket="/tmp/postgresqlsavepointtest.socket"/>
		</listeners>
		<translations>
			<translation module="normalize"/>
		</translations>
		<triggers>
			<trigger module="savepoints" when="all"/>
		</triggers>
		<connections>
			<connection string="host=postgresql;user=testuser;password=testpassword;db=@HOSTNAME@;typemangling=lookup;tablemangling=lookup"/>
		</connections>
	</instance>

</instances>
