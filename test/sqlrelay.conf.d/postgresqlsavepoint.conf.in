<?xml version="1.0"?>
<instances>

	<instance id="postgresqlsavepointtest" dbase="postgresql">
		<listeners>
			<listener port="9000" socket="/tmp/test.socket"/>
		</listeners>
		<translations>
			<translation module="normalize"/>
		</translations>
		<triggers>
			<trigger module="savepoints" when="both"/>
		</triggers>
		<connections>
			<connection string="host=postgresql;user=testuser;password=testpassword;db=@HOSTNAME@;typemangling=lookup;tablemangling=lookup"/>
		</connections>
	</instance>

</instances>
