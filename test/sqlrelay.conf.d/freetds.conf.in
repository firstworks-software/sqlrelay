<?xml version="1.0"?>
<instances>

	<instance id="freetds" dbase="freetds">
		<listeners>
			<listener port="9005" socket="/tmp/freetds.socket"/>
		</listeners>
		<connections>
			<connection string="freetds=@abs_top_builddir@/test/sqlrelay.conf.d/freetds;server=sap;user=testuser;password=testpassword;db=@HOSTNAME@"/>
		</connections>
		<resultsettranslations>
			<!-- freetds renders datetimes using the system
			     locales.conf date format, which varies by
			     freetds build (some render 26-char
			     "Jan  1 2001 01:00:00:000AM", others 19-char
			     "Jan  1 2001 01:00AM").  reformat to the 26-char
			     form so the test expectations are stable. -->
			<resultsettranslation module="reformatdatetime" datetimeformat="Mon  D YYYY HH:MI:SS:FFFAM" ignorenondatetime="yes"/>
		</resultsettranslations>
	</instance>

</instances>
