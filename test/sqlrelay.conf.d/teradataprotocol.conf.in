<?xml version="1.0"?>
<instances>

	<instance id="teradatatest" dbase="odbc" translatebindvariables="yes">
		<listeners>
			<listener protocol="teradata" port="1025" debug="yes"/>
		</listeners>
		<auths>
			<auth module="teradata_sidechannel" host="teradata" port="1025"/>
		</auths>
		<connections>
			<connection string="dsn=teradata;user=testuser;password=testpassword;autocommit=yes"/>
		</connections>
	</instance>

	<instance id="teradataauthtest" dbase="odbc" translatebindvariables="yes">
		<listeners>
			<listener protocol="teradata" port="1025" passthrough="disabled" debug="yes"/>
		</listeners>
		<auths>
			<auth module="sqlrclient_userlist">
				<user user="testuser" password="testpassword"/>
			</auth>
		</auths>
		<auths>
			<auth module="teradata_sidechannel" host="teradata" port="1025"/>
		</auths>
		<connections>
			<connection string="dsn=teradata;user=testuser;password=testpassword;autocommit=yes"/>
		</connections>
	</instance>

</instances>
