<?xml version="1.0"?>
<instances>

	<instance id="teradataprotocol" dbase="odbc" translatebindvariables="yes">
		<listeners>
			<listener protocol="teradata" port="1025" debug="yes"/>
		</listeners>
		<auths>
			<auth module="teradata_sidechannel" host="teradata" port="1025"/>
		</auths>
		<connections>
			<connection string="dsn=teradata;user=testuser;password=testpassword;autocommit=yes"/>
		</connections>
	</instance>

	<!-- the two instances in this file are mutually exclusive by design.
	     one has passthrough enabled, the other disabled, so they share
	     port 1025 and only one is started at a time. -->
	<instance id="teradataauth" dbase="odbc" translatebindvariables="yes" connections="1">
		<listeners>
			<listener protocol="teradata" port="1025" passthrough="disabled" debug="yes"/>
		</listeners>
		<auths>
			<auth module="sqlrclient_userlist">
				<user user="testuser" password="testpassword"/>
			</auth>
		</auths>
		<auths>
			<auth module="teradata_sidechannel" host="teradata" port="1025"/>
		</auths>
		<connections>
			<connection string="dsn=teradata;user=testuser;password=testpassword;autocommit=yes"/>
		</connections>
	</instance>

</instances>
