<?xml version="1.0"?>
<instances>

	<instance id="mssql" dbase="odbc">
		<listeners>
			<listener port="9007" socket="/tmp/mssql.socket"/>
		</listeners>
		<connections>
			<connection string="dsn=mssqlodbc;user=testuser;password=testpassword;lastinsertidquery=select @@identity"/>
		</connections>
	</instance>

	<instance id="emoji" dbase="odbc" translatebindvariables="yes">
		<listeners>
			<listener port="9025" socket="/tmp/emoji.socket"/>
		</listeners>
		<connections>
			<connection string="dsn=mssqlodbc;user=testuser;password=testpassword;lastinsertidquery=select @@identity;ncharencoding=UTF-16"/>
		</connections>
	</instance>

</instances>
