<?xml version="1.0"?>
<instances>

	<instance id="firebird" dbase="firebird">
		<listeners>
			<listener port="9009" socket="/tmp/firebirdtest.socket"/>
		</listeners>
		<connections>
			<connection string="user=testuser;password=testpassword;db=firebird:/u02/@HOSTNAME@.gdb;dialect=3"/>
		</connections>
	</instance>

	<instance id="firebird3" dbase="firebird">
		<listeners>
			<listener port="9009" socket="/tmp/firebirdtest.socket"/>
		</listeners>
		<connections>
			<connection string="user=testuser;password=testpassword;db=firebird3:/u02/@HOSTNAME@.gdb;dialect=3"/>
		</connections>
	</instance>

	<instance id="firebird2" dbase="firebird">
		<listeners>
			<listener port="9009" socket="/tmp/firebirdtest.socket"/>
		</listeners>
		<connections>
			<connection string="user=testuser;password=testpassword;db=firebird2:/u02/@HOSTNAME@.gdb;dialect=3"/>
		</connections>
	</instance>

	<!-- maxerrorsize is the error buffer size the connection module is
	     handed, and 32 is smaller than any real firebird error message,
	     so every error from this instance comes back truncated.  it is on
	     its own port because the instances above all share 9009 and only
	     one of them runs at a time. -->
	<instance id="firebirdmaxerrorsize" dbase="firebird" maxerrorsize="32">
		<listeners>
			<listener port="9029" socket="/tmp/firebirdmaxerrorsize.socket"/>
		</listeners>
		<connections>
			<connection string="user=testuser;password=testpassword;db=firebird:/u02/@HOSTNAME@.gdb;dialect=3"/>
		</connections>
	</instance>

</instances>
