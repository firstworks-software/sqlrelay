<?xml version="1.0"?>
<instances>

	<instance id="tdsfreetdsmssqlprotocol" dbase="odbc" translatebindvariables="yes">
		<listeners>
			<listener protocol="tds" port="1433" tdsversion="740"/>
		</listeners>
		<connections>
			<connection string="dsn=mssqlodbc;user=testuser;password=testpassword;mars=yes"/>
		</connections>
	</instance>

</instances>
