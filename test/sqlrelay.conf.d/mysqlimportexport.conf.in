<?xml version="1.0"?>
<instances>

	<instance id="mysqlimportexport" dbase="mysql">
		<listeners>
			<listener port="9019" socket="/tmp/mysqlimportexporttest.socket"/>
		</listeners>
		<connections>
			<connection string="host=mysql;user=testuser;password=testpassword;db=@HOSTNAME@;foundrows=yes"/>
		</connections>
	</instance>

</instances>
