<?xml version="1.0"?>
<instances>

	<instance id="tdsfreetdssapprotocol" dbase="sap" translatebindvariables="yes">
		<listeners>
			<listener protocol="tds" port="@TDSSAPPROTOCOLPORT1@"/>
		</listeners>
		<connections>
			<connection string="sybase=/opt/sap;lang=en_US;charset=utf8;server=SAP;user=testuser;password=testpassword;db=@HOSTNAME@"/>
		</connections>
	</instance>

</instances>
