<?xml version="1.0"?>
<instances>

	<instance id="postgresqlprotocol" dbase="postgresql">
		<listeners>
			<listener protocol="postgresql" port="@POSTGRESQLPROTOCOLPORT1@"/>
			<listener protocol="postgresql" port="@POSTGRESQLPROTOCOLPORT2@" passwords="cleartext"/>
		</listeners>
		<connections>
			<connection string="lastinsertidfunction=testfunc();user=testuser;password=testpassword;db=@HOSTNAME@;host=postgresql;typemangling=lookup;tablemangling=no"/>

		</connections>
	</instance>

</instances>
