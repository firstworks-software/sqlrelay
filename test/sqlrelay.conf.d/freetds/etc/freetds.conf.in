; This file is generated from freetds.conf.in.  Edit the .in template, not
; the generated file.
;
; The sqlrelay* entries below point at listeners this test suite starts, so
; their ports are substitution tokens rather than literals - the
; TDSPROTOCOLPORT1 and TDSSAPPROTOCOLPORT1 tokens that
; test/sqlrelay.conf.d/tdsprotocol.conf.in,
; tdsfreetdsmssqlprotocol.conf.in and tdsfreetdssapprotocol.conf.in use for
; the listener side, so one value drives both ends.  configure fills them in
; with the well known ports by default, and test.sh -randomports rewrites
; this file with the ports that run actually picked.  freetds and tsql read
; the port only from here - there is no command line option and no
; environment variable for it - so a suite run on other ports has to have
; this file rewritten too.
;
; The other entries name real database servers rather than listeners of
; ours, so their ports stay literal.

[global]
	tds version = auto

; the freetds-sap backend test runs against this one.  the client charset is
; set so that the suite covers #4783 - freetds multiplies the size it reports
; for character columns by the charset's maximum bytes per character, so
; without the fix testchar and testvarchar would report 160 rather than 40

[sap]
	host = sap
	port = 5000
	;tds version = 5.0
	client charset = UTF-8

[mssql2005]
	host = mssql2005
	port = 1433

[mssql2008]
	host = mssql2008
	port = 1433

[mssql2012]
	host = mssql2012
	port = 1433

[mssql2014]
	host = mssql2014
	port = 1433

[mssql2016]
	host = mssql2016
	port = 1433

; the tds protocol test uses these three - the two backends it establishes a
; native baseline against, and sqlrelay's own tds protocol module
;
; [sqlrelay] deliberately does not set a client charset, so that it matches
; [mssql] and the two runs stay comparable.  #8887 - freetds's #4783 multiply
; applies to whatever server it is talking to, so under "client charset =
; UTF-8" a char(20) is reported as 80 by a real sql server just as it is by
; sqlrelay, and the test's declared-width expectations can't hold for either.
; adding charset coverage here is #8793, and it has to set the charset on
; [mssql] too
;
; the freetds-mssql backend test shares [mssql] rather than declaring a section
; of its own.  it does not need a charset either: the connection module
; calibrates bytes per character from a probe query rather than from this file,
; so an unset charset just means a factor of 1.  don't set one here for its
; convenience - the tds protocol test above depends on it staying unset

[mssql]
	host = mssql
	port = 1433

[sybase]
	host = sybase
	port = 5000

[sqlrelay]
	host = localhost
	port = @TDSPROTOCOLPORT1@
	tds version = 7.0

; same instance as [sqlrelay] above, but requesting tds 7.4 - #9199 - the
; tds protocol test uses this to cover the >=7.2 wire-shape differences
; (DONE-token rowcount width and others) that 7.0 doesn't exercise

[sqlrelay74]
	host = localhost
	port = @TDSPROTOCOLPORT1@
	tds version = 7.4

; a second sqlrelay instance, fronting a sap/sybase backend instead of mssql,
; that tds-freetds can also target - sqlrelay's tds protocol module speaks
; the same wire protocol regardless of the backend behind it, so only the
; port differs

[sqlrelaysap]
	host = localhost
	port = @TDSSAPPROTOCOLPORT1@
	tds version = 7.0

; the tls scripts in test/protocol/tds drive these.  freetds takes its tls
; settings from here rather than from the client command line.  there is no
; mutual auth entry - freetds cannot present a client certificate
;
; these use tds version 7.4 rather than the 7.0 that [sqlrelay] above uses.
; freetds only sends a prelogin packet for tds 7.1 and later, and encryption is
; negotiated in the prelogin, so at 7.0 the encryption setting below is read and
; then never acted on - the connection goes straight to the login packet and
; succeeds in the clear

[sqlrelaytls]
	host = localhost
	port = @TDSPROTOCOLPORT1@
	tds version = 7.4
	client charset = UTF-8
	encryption = require

; ca-only validation, no hostname check - matches the verify-ca /
; --ssl-ca approach postgresqltlsserverauth.sh and mysqltlsserverauth.sh
; use.  the test cert (server.pem) has CN=server.localdomain with SANs
; server.localdomain/localdomain, which does not match "localhost", so
; hostname checking would fail here even with a valid chain.  freetds
; turns hostname checking on by default whenever a ca file is set, so
; it has to be turned off explicitly

[sqlrelaytlsserverauth]
	host = localhost
	port = @TDSPROTOCOLPORT1@
	tds version = 7.4
	client charset = UTF-8
	encryption = require
	ca file = /usr/local/firstworks/etc/sqlrelay.conf.d/ca.pem
	check certificate hostname = no
