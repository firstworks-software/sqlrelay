<?xml version="1.0"?>
<instances>

	<instance id="postgresqlsequencenextval" dbase="postgresql">
		<listeners>
			<listener port="9024" socket="/tmp/postgresqlsequencenextvaltest.socket"/>
		</listeners>
		<translations>
			<translation module="normalize"/>
			<translation module="sequence_nextval" style="nextval()"/>
		</translations>
		<connections>
			<connection string="host=postgresql;user=testuser;password=testpassword;db=@HOSTNAME@;typemangling=lookup;tablemangling=lookup"/>
		</connections>
	</instance>

</instances>
