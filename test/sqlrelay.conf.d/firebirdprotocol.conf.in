<?xml version="1.0"?>
<instances>

	<!-- isql compiles a request per lookup and holds them all for the
	     life of the attachment - a single show table takes 15 - so the
	     default cursor count is nowhere near enough -->
	<instance id="firebirdprotocol" dbase="firebird" debug="protocols" maxcursors="64">
		<listeners>
			<listener protocol="firebird" port="3050"/>
		</listeners>
		<connections>
			<connection string="user=testuser;password=testpassword;db=firebird:/u02/@HOSTNAME@.gdb;dialect=3"/>
		</connections>
	</instance>

	<!-- same as firebirdprotocol, but with fakeinputbindvariables="yes",
	     to exercise a select-with-binds describe when the server defers
	     the prepare and fakes the input binds itself -->
	<instance id="firebirdprotocolfakebinds" dbase="firebird" debug="protocols" fakeinputbindvariables="yes" maxcursors="64">
		<listeners>
			<listener protocol="firebird" port="3051"/>
		</listeners>
		<connections>
			<connection string="user=testuser;password=testpassword;db=firebird:/u02/@HOSTNAME@.gdb;dialect=3"/>
		</connections>
	</instance>

	<!-- same as firebirdprotocol, but with wirecrypt="required", to
	     exercise the Arc4 wire-crypt negotiation end to end - a client
	     that can't or won't negotiate crypt is refused outright, so any
	     query that succeeds here proves a real encrypted round trip -->
	<instance id="firebirdprotocolwirecrypt" dbase="firebird" debug="protocols" maxcursors="64">
		<listeners>
			<listener protocol="firebird" port="3052" wirecrypt="required"/>
		</listeners>
		<connections>
			<connection string="user=testuser;password=testpassword;db=firebird:/u02/@HOSTNAME@.gdb;dialect=3"/>
		</connections>
	</instance>

</instances>
