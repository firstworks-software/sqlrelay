<?xml version="1.0"?>
<instances>

	<!-- this file now holds only the TLS instance, driven by
	     tdstls.sh / tdstlsserverauth.sh; the plain (non-TLS) tds-vs-mssql
	     combo lives in tdsfreetdsmssqlprotocol.conf.in -->

	<!-- freetds cannot present a client certificate, so there is no
	     mutual-auth counterpart to this instance -->
	<instance id="tdsprotocoltls" dbase="odbc" translatebindvariables="yes">
		<listeners>
			<listener protocol="tds" port="1433"
				tls="yes"
				tlscert="@abs_top_builddir@/test/sqlrelay.conf.d/tls/server.pem"
				tlspassword="password"/>
		</listeners>
		<connections>
			<connection string="dsn=mssqlodbc;user=testuser;password=testpassword;mars=yes"/>
		</connections>
	</instance>

</instances>
