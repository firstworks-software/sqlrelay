<?xml version="1.0"?>
<instances>

	<instance id="mysqldeadlockreplay" dbase="mysql" connections="2">
		<listeners>
			<listener port="9017" socket="/tmp/mysqldeadlockreplay.socket"/>
		</listeners>
                <translations>
                        <translation module="normalize"/>
                </translations>
                <triggers>
                        <trigger module="replay" when="after">
                                <!-- deadlock.  the log file is the only place
                                     the queries the replay actually ran show
                                     up, so it's where the test looks for the
                                     substituted auto-increment value and for
                                     the clause that follows the values list -->
                                <condition error="1213" scope="transaction">
                                        <log file="/tmp/mysqldeadlockreplay-deadlock.log"/>
                                </condition>
                                <!-- lock wait timeout -->
                                <condition error="1205" scope="query"/>
                        </trigger>
                </triggers>
		<connections>
			<connection string="host=mysql;user=testuser;password=testpassword;db=@HOSTNAME@;foundrows=yes;autocommit=yes"/>
		</connections>
	</instance>

</instances>
