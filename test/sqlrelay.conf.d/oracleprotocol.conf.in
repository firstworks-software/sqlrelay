<?xml version="1.0"?>
<instances>

	<!-- These instances are pinned at serverversion="11.2".
	     OCI 23.26, in the portable encoding, reads only the 11.2
	     summary-object shape.  At the module's 12.1 default, the OCI
	     client this test uses cannot even log in; it gets ORA-03113.
	     That choice has a direct cost: no thin-mode Oracle driver
	     - python-oracledb, node-oracledb - can connect to any of
	     these instances.  A thin-mode client does not fail cleanly
	     against serverversion="11.2".  It hangs forever at login
	     instead, with no error.  See the Server Version section of
	     doc/admin/configguide.wt for the full trade-off across every
	     client tested against this module. -->
	<!-- HOST=oracle below (used by this instance and by 11g, 12c,
	     connectstrings, and fetchatonce below) resolves to a real 12.2
	     backend, which under its default SQLNET.ALLOWED_LOGON_VERSION_SERVER
	     setting (11) requires the O5LOGON auth exchange, introduced in
	     Oracle 11.1.  A pre-11g OCI client - eg. solaris8sparc's 9.0.1
	     install - has no O5LOGON support, so its backend connection
	     fails with ORA-28040 "No matching authentication protocol"
	     (#9796).  Lowering ALLOWED_LOGON_VERSION_SERVER on this shared
	     backend would let an old client in, but that's a farm-ops call
	     on a resource other tests also depend on, not a sqlrelay fix -
	     same reasoning as oracleprotocoloci7's separate backend below
	     (#9654).  A host that old can only exercise the backend leg of
	     this module through oracleprotocoloci7. -->
	<instance id="oracleprotocol" dbase="oracle" debug="protocols">
		<listeners>
			<listener protocol="oracle" port="@ORACLEPROTOCOLPORT1@" serverversion="11.2" sid="ora1"/>
			<!-- #9633 - a listener that never advertises the
			     big-chunk clr capability bit and always frames
			     raw bytes, for the go-ora v1 case. -->
			<listener protocol="oracle" port="@ORACLEPROTOCOLPORT6@" serverversion="11.2" sid="ora1" bigchunkclr="off"/>
		</listeners>
		<auths>
			<auth module="oracle_userlist">
				<user user="testuser" password="testpassword"/>
				<user user="TESTUSER" password="testpassword"/>
			</auth>
		</auths>
		<connections>
			<connection string="oracle_sid=(DESCRIPTION = (ADDRESS = (PROTOCOL = TCP)(HOST = oracle)(PORT = 1521)) (CONNECT_DATA = (SERVER = DEDICATED) (SERVICE_NAME = ora1)));user=@HOSTNAME@;password=testpassword;date_to_text_format=YYYY-MM-DD HH24:MI:SS"/>
		</connections>
	</instance>

	<!-- same as oracleprotocol, but with verifiertype="11g", to
	     exercise the 11g O5LOGON verifier - a 48-byte session key and
	     an sha1 verifier.  the tnsnames.ora alias sqlrelay11g points
	     here. -->
	<instance id="oracleprotocol11g" dbase="oracle" debug="protocols">
		<listeners>
			<listener protocol="oracle" port="@ORACLEPROTOCOLPORT2@" serverversion="11.2" verifiertype="11g" sid="ora1"/>
		</listeners>
		<auths>
			<auth module="oracle_userlist">
				<user user="testuser" password="testpassword"/>
				<user user="TESTUSER" password="testpassword"/>
			</auth>
		</auths>
		<connections>
			<connection string="oracle_sid=(DESCRIPTION = (ADDRESS = (PROTOCOL = TCP)(HOST = oracle)(PORT = 1521)) (CONNECT_DATA = (SERVER = DEDICATED) (SERVICE_NAME = ora1)));user=@HOSTNAME@;password=testpassword;date_to_text_format=YYYY-MM-DD HH24:MI:SS"/>
		</connections>
	</instance>

	<!-- same as oracleprotocol, but with verifiertype="12c", to
	     exercise the 12c O5LOGON verifier - a 32-byte session key and
	     a pbkdf2-hmac-sha512 verifier.  the tnsnames.ora alias
	     sqlrelay12c points here. -->
	<instance id="oracleprotocol12c" dbase="oracle" debug="protocols">
		<listeners>
			<listener protocol="oracle" port="@ORACLEPROTOCOLPORT3@" serverversion="11.2" verifiertype="12c" sid="ora1"/>
		</listeners>
		<auths>
			<auth module="oracle_userlist">
				<user user="testuser" password="testpassword"/>
				<user user="TESTUSER" password="testpassword"/>
			</auth>
		</auths>
		<connections>
			<connection string="oracle_sid=(DESCRIPTION = (ADDRESS = (PROTOCOL = TCP)(HOST = oracle)(PORT = 1521)) (CONNECT_DATA = (SERVER = DEDICATED) (SERVICE_NAME = ora1)));user=@HOSTNAME@;password=testpassword;date_to_text_format=YYYY-MM-DD HH24:MI:SS"/>
		</connections>
	</instance>

	<!-- same as oracleprotocol, but with no explicit <auths> block,
	     to exercise the default oracle_connectstrings auth path (#9309)
	     - the client authenticates directly against the connect
	     string's user/password rather than an explicit users list.  the
	     tnsnames.ora alias sqlrelayconnectstrings points here. -->
	<instance id="oracleprotocolconnectstrings" dbase="oracle" debug="protocols">
		<listeners>
			<listener protocol="oracle" port="@ORACLEPROTOCOLPORT4@" serverversion="11.2" sid="ora1"/>
		</listeners>
		<connections>
			<connection string="oracle_sid=(DESCRIPTION = (ADDRESS = (PROTOCOL = TCP)(HOST = oracle)(PORT = 1521)) (CONNECT_DATA = (SERVER = DEDICATED) (SERVICE_NAME = ora1)));user=testuser;password=testpassword;date_to_text_format=YYYY-MM-DD HH24:MI:SS"/>
		</connections>
	</instance>

	<!-- same as oracleprotocol, but with fetchatonce=1 on the connection
	     string.  the default fetchatonce=10 pulls a small test result
	     set entirely into execute-time inline prefetch, so a backend
	     error that only shows up on a later row (from OCIStmtFetch2)
	     can never actually happen - it always surfaces during
	     OCIStmtExecute instead.  fetchatonce=1 forces a real second
	     fetch call, so an error on the second-or-later row lands where
	     sendFetch3Response() actually handles it (#9601).  the
	     tnsnames.ora alias sqlrelayfetchatonce points here. -->
	<instance id="oracleprotocolfetchatonce" dbase="oracle" debug="protocols">
		<listeners>
			<listener protocol="oracle" port="@ORACLEPROTOCOLPORT5@" serverversion="11.2" sid="ora1"/>
		</listeners>
		<auths>
			<auth module="oracle_userlist">
				<user user="testuser" password="testpassword"/>
			</auth>
		</auths>
		<connections>
			<connection string="oracle_sid=(DESCRIPTION = (ADDRESS = (PROTOCOL = TCP)(HOST = oracle)(PORT = 1521)) (CONNECT_DATA = (SERVER = DEDICATED) (SERVICE_NAME = ora1)));user=@HOSTNAME@;password=testpassword;date_to_text_format=YYYY-MM-DD HH24:MI:SS;fetchatonce=1"/>
		</connections>
	</instance>

	<!-- same as oracleprotocol, but with its own backend, since a
	     client old enough to speak OCI7 (#9651, #9653) is also too old to
	     authenticate to the same modern backend the other instances above
	     use - see #9654.  the listener also uses verifiertype="9i" (#9658)
	     rather than the default, since an OCI7 client speaks O3LOGON, not
	     O5LOGON, on the client-facing side too.  the tnsnames.ora alias
	     sqlrelayoci7 points here. -->
	<instance id="oracleprotocoloci7" dbase="oracle" debug="protocols">
		<listeners>
			<listener protocol="oracle" port="@ORACLEPROTOCOLPORT7@" serverversion="11.2" verifiertype="9i" sid="ora1"/>
		</listeners>
		<auths>
			<auth module="oracle_userlist">
				<user user="testuser" password="testpassword"/>
				<user user="TESTUSER" password="testpassword"/>
			</auth>
		</auths>
		<connections>
			<!-- oracle102centos4x86.firstworks.com is the farm's only
			     OCI7-tested backend (#9664 comment 21); its hostname
			     isn't recorded anywhere else in this tree, so HOST is
			     given as the confirmed IP (10.0.2.3) instead. -->
			<connection string="oracle_sid=(DESCRIPTION = (ADDRESS = (PROTOCOL = TCP)(HOST = 10.0.2.3)(PORT = 1521)) (CONNECT_DATA = (SERVER = DEDICATED) (SERVICE_NAME = ora1)));user=@HOSTNAME@;password=testpassword;date_to_text_format=YYYY-MM-DD HH24:MI:SS"/>
		</connections>
	</instance>

</instances>
