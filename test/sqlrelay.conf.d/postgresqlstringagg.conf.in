<?xml version="1.0"?>
<instances>

	<instance id="postgresqlstringagg" dbase="postgresql">
		<listeners>
			<listener port="9023" socket="/tmp/postgresqlstringaggtest.socket"/>
		</listeners>
		<translations>
			<translation module="normalize"/>
			<translation module="listagg_to_string_agg"/>
		</translations>
		<connections>
			<connection string="host=postgresql;user=testuser;password=testpassword;db=@HOSTNAME@;typemangling=lookup;tablemangling=lookup"/>
		</connections>
	</instance>

</instances>
