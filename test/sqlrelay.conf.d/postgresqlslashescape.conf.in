<?xml version="1.0"?>
<instances>

	<instance id="postgresqlslashescape" dbase="postgresql">
		<listeners>
			<listener port="9035" socket="/tmp/postgresqlslashescape.socket"/>
		</listeners>
		<translations>
			<translation module="normalize"/>
		</translations>
		<connections>
			<connection string="host=postgresql;user=testuser;password=testpassword;db=@HOSTNAME@;typemangling=lookup;tablemangling=lookup"/>
		</connections>
	</instance>

</instances>
