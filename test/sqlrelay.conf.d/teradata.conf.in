<?xml version="1.0"?>
<instances>

	<instance id="teradatatest" dbase="odbc">
		<listeners>
			<listener port="9011" socket="/tmp/teradatatest.socket"/>
		</listeners>
		<auths>
			<auth module="sqlrclient_userlist">
				<user user="testuser" password="testpassword"/>
			</auth>
		</auths>
		<connections>
			<connection string="dsn=teradata;user=testuser;password=testpassword;autocommit=yes"/>
		</connections>
	</instance>

</instances>
