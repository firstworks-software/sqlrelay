<?xml version="1.0"?>
<instances>

	<instance id="multiprotocol" dbase="mysql">
		<listeners>
			<listener protocol="sqlrclient" port="9026"/>
			<listener protocol="mysql" port="9027"/>
			<listener protocol="postgresql" port="9028"/>
		</listeners>
		<connections>
			<connection string="host=mysql;user=testuser;password=testpassword;db=@HOSTNAME@;foundrows=yes"/>
		</connections>
	</instance>

</instances>
