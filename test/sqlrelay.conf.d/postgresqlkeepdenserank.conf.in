<?xml version="1.0"?>
<instances>

	<instance id="postgresqlkeepdenserank" dbase="postgresql">
		<listeners>
			<listener port="9034" socket="/tmp/postgresqlkeepdenserank.socket"/>
		</listeners>
		<translations>
			<translation module="normalize"/>
			<translation module="keep_dense_rank_to_array_agg"/>
		</translations>
		<connections>
			<connection string="host=postgresql;user=testuser;password=testpassword;db=@HOSTNAME@;typemangling=lookup;tablemangling=lookup"/>
		</connections>
	</instance>

</instances>
