<?xml version="1.0"?>
<instances>

	<instance id="mysqlupserttest" dbase="mysql">
		<listeners>
			<listener port="9016" socket="/tmp/mysqlupserttest.socket"/>
		</listeners>
		<translations>
			<translation module="normalize"/>
		</translations>
		<triggers>
			<trigger module="upsert" when="after">
				<errors>
					<error number="1062"/>
				</errors>
				<tables>
					<table name="student">
						<primarykey name="id"/>
						<column name="firstname"/>
						<column name="lastname"/>
					</table>
				</tables>
			</trigger>
		</triggers>
		<connections>
			<connection string="host=mysql;user=testuser;password=testpassword;db=@HOSTNAME@;foundrows=yes"/>
		</connections>
	</instance>

</instances>
