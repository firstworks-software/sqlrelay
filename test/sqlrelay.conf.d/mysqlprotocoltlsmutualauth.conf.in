<?xml version="1.0"?>
<instances>

	<instance id="mysqlprotocoltlsmutualauth" dbase="mysql">
		<listeners>
			<listener protocol="mysql" port="@MYSQLPROTOCOLTLSMUTUALAUTHPORT1@"
				tls="yes"
				tlscert="@abs_top_builddir@/test/sqlrelay.conf.d/tls/server.pem"
				tlspassword="password"
				tlsvalidate="yes"
				tlsca="@abs_top_builddir@/test/sqlrelay.conf.d/tls/ca.pem"/>
		</listeners>
		<connections>
			<connection string="host=mysql;user=testuser;password=testpassword;db=@HOSTNAME@;charset=latin1;foundrows=yes"/>
		</connections>
	</instance>

</instances>
