<?xml version="1.0"?>
<instances>

	<!-- unlike freetds-mssql.conf.in, this instance has no
	     reformatdatetime resultsettranslation.  the odbc module
	     renders datetimes straight from the driver's
	     SQL_TIMESTAMP_STRUCT into fixed ISO forms, with no locale
	     involved, so the widths are already stable: 23 for
	     datetime, 19 for smalldatetime, 10 for date, 16 for time,
	     27 for datetime2.  there is nothing here for a reformat
	     to stabilize. -->
	<instance id="odbc-mssql" dbase="odbc">
		<listeners>
			<listener port="9007" socket="/tmp/odbc-mssql.socket"/>
		</listeners>
		<connections>
			<connection string="dsn=mssqlodbc;user=testuser;password=testpassword;lastinsertidquery=select @@identity;db=@HOSTNAME@"/>
		</connections>
	</instance>

	<!-- maxfieldsize is the per-field buffer size the connection module
	     is handed, and the default of 32768 is large enough that even a
	     4000-char nvarchar column fits inside the half-truncated buffer
	     SQLBindCol produced when it bound the driver's UCS-2 output
	     directly into a UTF-8-sized buffer, so the bug can't be exposed
	     against a practical-length column at the default size.  a
	     smaller maxfieldsize makes the truncation reproducible at a
	     manageable column length.  it is on its own port because the
	     odbc-mssql instance above already owns 9007. -->
	<instance id="odbcmssqlmaxfieldsize" dbase="odbc">
		<listeners>
			<listener port="9033" socket="/tmp/odbcmssqlmaxfieldsize.socket"/>
		</listeners>
		<connections>
			<connection string="dsn=mssqlodbc;user=testuser;password=testpassword;lastinsertidquery=select @@identity;db=@HOSTNAME@;maxfieldsize=4096"/>
		</connections>
	</instance>

	<instance id="emoji" dbase="odbc" translatebindvariables="yes">
		<listeners>
			<listener port="9025" socket="/tmp/emoji.socket"/>
		</listeners>
		<connections>
			<connection string="dsn=mssqlodbc;user=testuser;password=testpassword;lastinsertidquery=select @@identity;ncharencoding=UTF-16"/>
		</connections>
	</instance>

</instances>
